# Optional server environment variables. Export them before starting the API;
# this example file is not loaded automatically by pnpm dev.
PORT=8787
QINGJIAN_DATA_DIR=
# Optional on first launch; otherwise a random token is created in data/admin-token.
QINGJIAN_ADMIN_TOKEN=
PUBLIC_BASE_PATH=
VITE_BASE_PATH=/
# Optional Alibaba OSS bucket. Configure all four together, or leave all empty for local storage.
# Set OSS_PUBLIC_READ=true only after the bucket allows anonymous reads and every media object is readable.
OSS_REGION=oss-ap-southeast-1
OSS_BUCKET=
OSS_PREFIX=qingjian
OSS_PUBLIC_READ=false
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Registration email. Keep the key in a private server environment file, never in VITE_*.
RESEND_API_KEY=
RESEND_FROM=
# Configure model IDs, service URLs and API keys at /admin after launch.
