.mask { position: fixed; inset: 0; z-index: 1000; background: rgba(40,32,24,.45); display: flex; align-items: center; justify-content: center; padding: 42rpx; }
.dialog { width: 100%; background: #fffdf9; border-radius: 32rpx; padding: 40rpx; }.heading { font-size: 32rpx; font-weight: 650; }.copy { font-size: 26rpx; color: #81766b; line-height: 1.8; margin: 24rpx 0; }.policy { color: #ae7851; font-size: 24rpx; padding: 16rpx 0; }.actions { display: flex; gap: 20rpx; margin-top: 22rpx; }.actions button { flex: 1; font-size: 24rpx; padding: 20rpx 10rpx; border-radius: 16rpx; background: #f1ece5; }.actions .agree { background: #ed815f; color: #fff; }
