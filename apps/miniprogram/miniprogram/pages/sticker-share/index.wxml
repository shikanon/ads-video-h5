<view class="screen theme-surface theme-{{theme}}"><view class="title">{{share ? share.name : '好友的表情作品'}}</view><view wx:if="{{loading}}" class="muted">正在读取作品…</view><view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="load">重新读取</button></view><block wx:if="{{share}}"><view class="muted">{{share.mode === 'static' ? '静态表情' : '动态表情'}} · 已完成 {{share.count}} 个动作</view><view class="share-grid"><button wx:for="{{items}}" wx:key="id" bindtap="preview" data-id="{{item.id}}"><image src="{{item.image}}" mode="aspectFit"/><text>{{item.id}}</text></button></view><button class="primary" bindtap="create">上传自己的角色，制作同款</button><view class="muted">制作使用自己的积分，提交前可查看费用。</view></block><view wx:if="{{selected}}" class="preview-mask" bindtap="closePreview"><image src="{{selected}}" mode="aspectFit"/></view></view>
