.eyebrow{font-size:22rpx;color:var(--lm-accent);margin:10rpx 0 16rpx}.intro{font-size:25rpx;line-height:1.8;margin:18rpx 0 28rpx}.sticker-grid{display:flex;flex-wrap:wrap;justify-content:space-between}.theme-surface .sticker-tile{box-sizing:border-box;display:flex;flex-direction:column;align-items:center;width:23%;margin:0 0 16rpx;padding:12rpx 4rpx;border:1rpx solid var(--lm-line);border-radius:22rpx;background:var(--lm-paper);color:var(--lm-ink);font-size:23rpx;line-height:1.6}.sticker-tile image{width:120rpx;height:120rpx}.story-form,.result{margin:26rpx 0}.story-form .row{font-size:26rpx;margin:18rpx 0}.field-label{font-size:25rpx;margin:24rpx 0 12rpx}.scene-hint{font-size:23rpx;line-height:1.8;margin:18rpx 0}.scene-row{display:flex;align-items:center;margin:22rpx 0}.scene-number{color:var(--lm-accent);width:48rpx;font-size:26rpx}.scene-fields{flex:1;min-width:0}.scene-picker{font-size:25rpx;margin-bottom:10rpx;color:var(--lm-accent)}.story-form .input{box-sizing:border-box;width:100%;height:76rpx;font-size:25rpx}.story-form .primary,.result button{margin-top:24rpx;width:100%;white-space:normal}.sample-title{margin:32rpx 0 20rpx}.sample{width:100%;height:640rpx;border-radius:24rpx;background:#27221e}.preview-mask{position:fixed;inset:0;z-index:100;background:rgba(30,22,18,.65);display:flex;align-items:center;justify-content:center;padding:40rpx}.preview-card{width:100%;padding:30rpx;background:var(--lm-paper);border-radius:32rpx;text-align:center;color:var(--lm-ink)}.preview-card image{width:480rpx;max-width:100%;height:480rpx}.preview-card .muted{font-size:23rpx;margin-top:14rpx}
