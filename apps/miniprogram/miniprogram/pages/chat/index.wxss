.account-editor-sheet { box-sizing:border-box; width:100%; padding:36rpx 32rpx 24rpx; background:var(--lm-paper); border-radius:32rpx 32rpx 0 0; }
.account-editor-sheet .editor-cancel { width:100%; margin-top:20rpx; padding:16rpx; }

.composer-template-chip { display: flex; width: fit-content; align-items: center; gap: 12rpx; color: var(--lm-accent); background: var(--lm-soft); border-radius: 10rpx; padding: 2rpx 12rpx; font-size: 20rpx; margin: 8rpx 0; }
.theme-surface .composer-template-chip .remove-template { color: var(--lm-accent); font-size: 27rpx; line-height: 1; padding: 5rpx; min-height: 0; height: auto; }

.sent-attachments { display:flex; flex-wrap:wrap; gap:12rpx; margin:12rpx 0; }
.theme-surface .sent-attachment,
.theme-surface .attachment {
  border:1rpx solid var(--lm-line);
  background:var(--lm-paper);
  color:var(--lm-ink);
}
.theme-surface .sent-attachment { max-width:min(100%, 360rpx); padding:12rpx; border-radius:18rpx; font-size:22rpx; overflow:hidden; text-align:left; }
.theme-surface .sent-attachment-pressed { background:var(--lm-soft); }
.sent-attachment image { display:block; width:220rpx; max-width:100%; height:220rpx; margin:0 auto 6rpx; border-radius:10rpx; background:var(--lm-bg); }
.sent-attachment text { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.model-hint { font-size:20rpx; padding-bottom:8rpx; }

.chat-mode-tabs { display:flex; flex-shrink:0; background:var(--lm-paper); border-bottom:1rpx solid var(--lm-line); }
.theme-surface .chat-mode-tabs button { position:relative; flex:1 1 0; min-width:0; height:62rpx; line-height:62rpx; margin:0; padding:0; border:0; border-radius:0; background:transparent; color:var(--lm-muted); font-size:26rpx; }
.chat-mode-tabs button + button::before { content:''; position:absolute; top:18rpx; bottom:18rpx; left:0; border-left:1rpx solid var(--lm-line); }
.theme-surface .chat-mode-tabs .active { color:var(--lm-accent); }
.chat-mode-indicator { position:absolute; left:50%; bottom:2rpx; width:66rpx; height:4rpx; border-radius:4rpx; transform:translateX(-50%); background:var(--lm-accent); }

.thread-inner.chat-with-suggestions { box-sizing:border-box; min-height:100%; display:flex; flex-direction:column; }
.work-suggestions { display:flex; flex-direction:column; align-items:flex-start; gap:10rpx; width:100%; flex-shrink:0; padding-top:10rpx; }
.chat-with-suggestions .work-suggestions { margin-top:auto; }
.theme-surface .work-suggestions button { display:flex; align-items:center; width:auto; max-width:100%; height:68rpx; min-height:68rpx; line-height:1.4; margin:0; padding:0 24rpx; background:var(--lm-paper); color:var(--lm-ink); font-size:28rpx; border:1rpx solid var(--lm-line); border-radius:28rpx; }
.theme-surface .work-suggestions button[disabled] { color:var(--lm-muted); }
.work-suggestions button::after { border:0; }
.composer-completion { display:flex; align-items:flex-start; gap:10rpx; min-height:70rpx; }
.theme-surface .composer-completion button { margin:0; padding:0; min-height:44rpx; line-height:44rpx; border:0; border-radius:0; background:transparent; }
.theme-surface .composer-completion .work-inline-hint { flex:1 1 auto; width:auto; min-width:0; color:var(--lm-muted); text-align:left; font-size:25rpx; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.theme-surface .composer-completion .composer-manual-input { flex:none; width:auto; padding:0 8rpx; color:var(--lm-accent); font-size:21rpx; }
.composer-completion button::after { border:0; }
.theme-surface .composer-actions .work-mention { width:48rpx; height:58rpx; line-height:58rpx; color:var(--lm-accent); font-size:28rpx; border-radius:16rpx; }

.work-card { margin:12rpx 0 22rpx; padding:18rpx; border:1rpx solid var(--lm-line); border-radius:20rpx; background:var(--lm-paper); }
.work-card-heading { display:flex; align-items:center; justify-content:space-between; gap:12rpx; margin-bottom:12rpx; color:var(--lm-ink); font-size:27rpx; }
.work-card-heading > text { min-width:0; overflow-wrap:break-word; }
.work-card .quiet { font-size:22rpx; }
.work-buttons { display:flex; flex-wrap:wrap; align-items:center; gap:10rpx; margin:10rpx 0; }
.work-buttons button, .work-card-heading button { margin:0; width:auto; }
.theme-surface .work-selected { background:var(--lm-soft); color:var(--lm-accent); }
.work-card .work-field { display:block; box-sizing:border-box; width:100%; min-height:56rpx; margin:10rpx 0; padding:9rpx 12rpx; border:1rpx solid var(--lm-line); border-radius:12rpx; font-size:24rpx; }
.work-card textarea.work-field { min-height:80rpx; max-height:200rpx; }
.work-card .work-buttons .work-field { width:auto; margin:0; }
.work-card .work-buttons .work-duration { width:95rpx; }
.theme-surface .work-list-button { display:block; min-width:0; width:100%; margin:6rpx 0; padding:10rpx; background:var(--lm-soft); border-radius:12rpx; font-size:23rpx; text-align:left; white-space:normal; overflow-wrap:break-word; }
.work-deliverable { display:flex; align-items:center; gap:10rpx; }
.work-deliverable .work-list-button { flex:1 1 auto; }
.work-deliverable > .small-button { flex:none; width:auto; margin:0; }
.work-styles { display:flex; gap:12rpx; margin:12rpx 0; }
.work-style { flex:1 1 0; min-width:0; }
.work-artifact-strip { display:block; width:100%; margin:9rpx 0; white-space:nowrap; }
.theme-surface .work-image-button { display:block; width:100%; padding:8rpx; background:var(--lm-soft); border-radius:14rpx; font-size:21rpx; white-space:normal; }
.work-image-button image { display:block; width:100%; height:150rpx; }
.theme-surface .work-artifact-strip .work-image-button { display:inline-block; width:140rpx; margin:0 9rpx 0 0; vertical-align:top; }
.work-artifact-strip .work-image-button image { height:116rpx; }
.work-preview-mask { z-index:75; }
.work-preview-sheet image, .work-preview-sheet video { display:block; width:100%; height:48vh; margin:10rpx 0; }
