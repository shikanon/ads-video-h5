ne); padding: 16rpx 0; }.tool-name { display: block; color: var(--lm-muted); font-size: 23rpx; }.tool-detail { display: block; white-space: pre-wrap; max-height: 300rpx; overflow: auto; }.artifact-link { display: flex; flex-direction: column; gap: 10rpx; background: var(--lm-soft); padding: 24rpx; margin-top: 18rpx; text-align: left; width: 100%; }.user .date { text-align: right; }.thread-end { height: 8rpx; }.older { margin: 0 auto 25rpx; }.composer-wrap { padding: 14rpx 22rpx 10rpx; background: var(--lm-paper); border-top: 1rpx solid var(--lm-line); }.composer-wrap > .error { margin: 4rpx 12rpx 15rpx; font-size: 22rpx; }.composer { border: 1rpx solid var(--lm-line); border-radius: 30rpx; padding: 24rpx; background: var(--lm-paper); }.composer textarea { min-height: 70rpx; max-height: 220rpx; width: 100%; font-size: 28rpx; line-height: 1.6; }.composer-actions { display: flex; justify-content: space-between; align-items: center; margin-top: 18rpx; }.composer-actions .row { width: auto; min-width: 0; flex: 0 0 auto; gap: 12rpx; }.icon-button { font-size: 40rpx; width: 52rpx; color: var(--lm-muted); }.newline { width: 100rpx; color: var(--lm-muted); font-size: 22rpx; }.send-button { background: var(--lm-accent); color: var(--lm-paper); width: 70rpx; height: 70rpx; border-radius: 50%; font-size: 40rpx; line-height: 70rpx; }.voice-button { border-radius: 50%; background: var(--lm-soft); width: 78rpx; height: 74rpx; font-size: 27rpx; line-height: 38rpx; }.voice-button text { display: block; font-size: 16rpx; line-height: 20rpx; color: var(--lm-muted); }.stop-button { width: 88rpx; color: var(--lm-accent); font-size: 20rpx; }.composer-note { text-align: center; font-size: 18rpx; margin-top: 9rpx; }.voice-status { text-align: center; color: var(--lm-muted); font-size: 23rpx; padding: 12rpx; }.voice-status.live { color: var(--lm-accent); }.credit-warning { color: var(--lm-accent); font-size: 24rpx; padding: 8rpx 12rpx 16rpx; }.attachments { white-space: nowrap; margin-bottom: 14rpx; }.attachment { display: inline-flex; align-items: center; gap: 10rpx; max-width: 300rpx; padding: 6rpx 18rpx; background: var(--lm-soft); border-radius: 18rpx; margin-right: 12rpx; font-size: 22rpx; }.attachment text { overflow: hidden; text-overflow: ellipsis; }.attachment button { padding: 0 4rpx; color: var(--lm-muted); }.picker-mask { position: fixed; inset: 0; background: rgba(40,31,23,.25); z-index: 30; display: flex; align-items: flex-end; }.picker-sheet { width: 100%; padding: 35rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); background: var(--lm-paper); border-radius: 36rpx 36rpx 0 0; }.source-list { height: 50vh; margin: 25rpx 0; }.source-row { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; padding: 22rpx; border-bottom: 1rpx solid var(--lm-line); border-radius: 12rpx; text-align: left; font-size: 25rpx; }.source-row > text:first-child { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }.source-row.selected { background: var(--lm-soft); }

.mic-mark { width: 32rpx; height: 34rpx; position: relative; margin: 6rpx auto 2rpx; }.mic-capsule { position: absolute; left: 10rpx; top: 0; width: 13rpx; height: 22rpx; border: 3rpx solid var(--lm-line); border-radius: 12rpx; }.mic-arc { position: absolute; left: 4rpx; top: 12rpx; width: 25rpx; height: 17rpx; border: 3rpx solid var(--lm-line); border-top: 0; border-radius: 0 0 15rpx 15rpx; }.mic-stand { position: absolute; left: 15rpx; top: 27rpx; width: 3rpx; height: 7rpx; background: var(--lm-muted); }.voice-button .record-dot { color: var(--lm-accent); font-size: 28rpx; line-height: 38rpx; }

/* Explicit toolbar sizes override native button sizing on Android and iOS. */
