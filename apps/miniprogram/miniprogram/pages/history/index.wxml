<view class="screen"><view class="page-heading"><text>会话历史</text><button class="secondary" bindtap="create" disabled="{{busy}}">＋ 新对话</button></view><view wx:if="{{!sessions.length}}" class="empty"><text class="title">还没有对话</text><text class="muted">开始描述你想制作的视频。</text></view><button wx:for="{{sessions}}" wx:key="id" class="session panel {{item.selected ? 'selected' : ''}}" disabled="{{busy}}" bindtap="activate" data-id="{{item.id}}"><view class="row spread"><text class="title">{{item.title}}</text><text wx:if="{{item.running || item.selected}}" class="tag">{{item.running ? '制作中' : '当前'}}</text></view><text class="date">{{item.date}} · {{item.count}} 条消息</text></button><button wx:if="{{more}}" class="secondary" bindtap="more">加载更多</button></view><privacy-dialog id="privacy" />
