<view class="theme-surface theme-{{theme}}">
<view wx:if="{{restoring || loadingState}}" class="startup-status">{{stateSyncError ? '暂未同步，显示上次内容' : '正在同步资源…'}}</view>
<view class="screen resource-screen">
  <view class="resource-heading"><view><view class="resource-eyebrow">LIGHTMAO / MY SPACE</view><view class="resource-title">我的资源</view></view><button class="add-resource" bindtap="upload" loading="{{uploading}}" disabled="{{uploading}}">＋ 添加素材</button></view>
  <view class="resource-tabs"><button class="resource-tab {{section === 'materials' ? 'selected' : ''}}" bindtap="section" data-section="materials">素材<text>{{materialCount}}</text></button><button class="resource-tab {{section === 'films' ? 'selected' : ''}}" bindtap="section" data-section="films">成片<text>{{filmCount}}</text></button></view>
  <input class="input media-search" placeholder="{{section === 'materials' ? '搜索素材名称或镜头标签' : '搜索作品名称'}}" value="{{query}}" bindinput="search" maxlength="80"/>
  <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="resource-filter-scroll"><view class="resource-kinds"><button wx:for="{{kindFilters}}" wx:key="id" class="resource-kind {{filter === item.id ? 'selected' : ''}}" data-kind="{{item.id}}" bindtap="filter">{{item.name}}<text>{{kindCounts[item.id] || 0}}</text></button></view></scroll-view>
  <block wx:if="{{section === 'materials'}}">
    <view class="collection-tabs"><button class="{{collection === 'library' ? 'selected' : ''}}" bindtap="collection" data-collection="library">可用素材</button><button class="{{collection === 'clips' ? 'selected' : ''}}" bindtap="collection" data-collection="clips">镜头归档</button><button class="{{collection === 'production' ? 'selected' : ''}}" bindtap="collection" data-collection="production">制作归档</button></view>
    <view class="resource-tools"><button class="small-button" bindtap="film">拉片工作台 ↗</button><button class="small-button" bindtap="livePhotoHelp">导入实况照片 ›</button></view>
    <view wx:if="{{collection === 'production'}}" class="quiet collection-note">制作过程文件保留在这里，可从卡片菜单恢复。</view>
  </block>
  <view wx:if="{{uploading}}" class="notice">{{uploadText}}</view>
  <view wx:for="{{jobs}}" wx:key="id" class="panel running-card" bindtap="session" data-id="{{item.id}}"><view class="row spread"><text class="title">{{item.label}}</text><text class="tag">{{item.progress}}%</text></view><view class="muted">{{item.stage}}</view><progress percent="{{item.progress}}" stroke-width="3" activeColor="{{progressColor}}" backgroundColor="{{progressTrack}}"/><text class="quiet">查看制作过程 →</text></view>
  <view class="result-summary"><text>{{query ? '搜索结果' : section === 'films' ? '已完成的创作' : '收好的创作素材'}}</text><text>{{count}} 个</text></view>
  <view wx:if="{{!items.length && !loadingState}}" class="empty"><image class="empty-icon" src="{{icons.library}}" mode="aspectFit"/><text class="title">{{query || filter !== 'all' ? '没有找到匹配的内容' : section === 'films' ? '第一支作品，等你开启' : collection === 'production' ? '还没有制作归档' : collection === 'clips' ? '还没有归档镜头' : '把素材带进来'}}</text><view class="muted">{{section === 'films' ? '制作完成后，作品会自动同步到这里。' : '添加图片、视频或音频，收好每一份创作灵感。'}}</view><button wx:if="{{section === 'films'}}" class="secondary" bindtap="create">去创作 ↗</button><button wx:else class="secondary" bindtap="upload">添加素材 ＋</button></view>
  <view class="card-grid resource-grid"><view wx:for="{{items}}" wx:key="id" class="media-tile">
    <view class="tile-preview" bindtap="play" data-id="{{item.id}}"><image wx:if="{{item.cover}}" class="media-cover" src="{{item.cover}}" mode="aspectFill" lazy-load data-id="{{item.id}}" binderror="coverError"/><view wx:else class="media-cover media-placeholder"><image class="placeholder-icon" src="{{item.kind === 'audio' ? placeholderIcons.voice : item.kind === 'image' ? placeholderIcons.library : placeholderIcons.films}}" mode="aspectFit"/><text>{{item.kind === 'video' ? '视频' : item.kind === 'audio' ? '音频' : item.kind === 'game' ? '游戏' : item.kind === 'sticker-pack' ? '表情套装' : '图片'}}</text></view><text wx:if="{{item.duration}}" class="tile-duration">{{item.duration}}</text><text wx:if="{{item.production || item.archivedClip}}" class="tile-marker">{{item.production ? '过程' : '镜头'}}</text><button wx:if="{{item.coverError}}" class="retry-thumb" catchtap="retryCover">重试</button></view>
    <view class="tile-caption"><text class="media-name" bindtap="play" data-id="{{item.id}}">{{item.name}}</text><button class="tile-menu" catchtap="itemMenu" data-id="{{item.id}}" aria-label="{{item.name}}的更多操作">···</button></view>
  </view></view>
  <button wx:if="{{more}}" class="secondary load-more" bindtap="more">加载更多</button>
</view><privacy-dialog id="privacy"/>
</view>
