<view class="theme-surface theme-{{theme}}">
  <view wx:if="{{restoring || loadingState}}" class="startup-status">{{stateSyncError ? '暂未同步，显示上次内容' : '正在同步资源…'}}</view>
  <view class="screen resource-home">
    <button size="mini" class="wallet-card" bindtap="credits">
      <view>
        <view class="wallet-eyebrow">为灵感，添一点能量</view>
        <text class="wallet-label">我的创作积分</text>
        <text class="wallet-balance">{{guest ? '—' : loadingState ? '…' : balance}}</text>
        <view class="wallet-caption">给每一个灵感，添一点能量</view>
      </view>
      <view class="wallet-action">
        <text>{{guest ? '登录查看积分' : canCheckIn && !loadingState ? '签到领取 +' + dailyReward : '查看积分明细'}}</text>
        <image class="ui-icon" src="{{onPrimary.send}}" mode="aspectFit"/>
      </view>
    </button>
    <view class="resource-entries">
      <navigator class="resource-entry" url="/pages/materials/index" hover-class="resource-entry-pressed">
        <image class="ui-icon resource-entry-icon" src="{{icons.library}}" mode="aspectFit" aria-hidden="true"/>
        <text class="resource-entry-label">素材</text>
        <text class="resource-entry-count">{{loadingState ? '…' : materialCount + ' 项'}}</text>
        <text class="resource-entry-arrow" aria-hidden="true">›</text>
      </navigator>
      <navigator class="resource-entry" url="/pages/films/index" hover-class="resource-entry-pressed">
        <image class="ui-icon resource-entry-icon" src="{{icons.films}}" mode="aspectFit" aria-hidden="true"/>
        <text class="resource-entry-label">成片</text>
        <text class="resource-entry-count">{{loadingState ? '…' : filmCount + ' 项'}}</text>
        <text class="resource-entry-arrow" aria-hidden="true">›</text>
      </navigator>
    </view>
    <view class="quiet resource-version">轻喵LightMao · {{version}}<view>微信账号独立保存作品与积分。</view></view>
  </view>
</view>
