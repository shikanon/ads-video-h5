<view class="screen"><view class="page-heading"><text>我的素材<text class="count">{{count}}</text></text><button class="secondary" bindtap="upload" loading="{{uploading}}" disabled="{{uploading}}">＋ 添加</button></view><view class="subtitle">与轻剪 H5 同步，选好素材就可以开始创作。</view><view class="filters"><button class="{{filter === 'all' ? 'selected' : ''}}" data-kind="all" bindtap="filter">全部</button><button class="{{filter === 'video' ? 'selected' : ''}}" data-kind="video" bindtap="filter">视频</button><button class="{{filter === 'image' ? 'selected' : ''}}" data-kind="image" bindtap="filter">图片</button><button class="{{filter === 'audio' ? 'selected' : ''}}" data-kind="audio" bindtap="filter">音频</button></view><view wx:if="{{uploading}}" class="notice">{{uploadText}}</view>
  <view wx:if="{{!items.length}}" class="empty"><text class="empty-mark">▧</text><text class="title">把素材带进来</text><view class="muted">添加视频、图片或音频，让轻剪帮你剪出故事。<view>也可以直接到创作页描述主题。</view></view></view>
  <view class="card-grid"><view wx:for="{{items}}" wx:key="id" class="media-tile"><view bindtap="play" data-id="{{item.id}}"><image wx:if="{{item.cover}}" class="media-cover" src="{{item.cover}}" mode="aspectFill" /><view wx:else class="media-cover media-placeholder">{{item.kind === 'video' ? '▷ 视频' : item.kind === 'audio' ? '♫ 音频' : '▧ 图片'}}</view><view class="media-info"><text class="media-name">{{item.name}}</text><text class="muted">{{item.duration}}</text><text class="date">{{item.date}}</text></view></view><view class="media-actions"><button class="small-button" bindtap="use" data-id="{{item.id}}">用来创作</button><button class="delete-button" bindtap="remove" data-id="{{item.id}}">删除</button></view></view></view><button wx:if="{{more}}" class="secondary load-more" bindtap="more">加载更多</button>
</view><privacy-dialog id="privacy" />
