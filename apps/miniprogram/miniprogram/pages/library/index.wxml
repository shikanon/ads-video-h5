<view class="theme-surface theme-{{theme}}">
<view wx:if="{{restoring || loadingState}}" class="startup-status">{{stateSyncError ? '暂未同步，显示上次内容' : restoring ? '已显示上次内容，正在同步…' : '正在加载…'}}</view>
<view class="screen resource-screen">
  <view class="resource-heading"><view class="resource-eyebrow">轻喵创作工坊</view><view class="resource-title">我的资源</view><view class="subtitle">收好每一份素材，也珍藏每一次创作。</view></view>
  <view class="resource-tabs"><button class="resource-tab {{section === 'materials' ? 'selected' : ''}}" bindtap="section" data-section="materials">素材<text>{{materialCount}}</text></button><button class="resource-tab {{section === 'films' ? 'selected' : ''}}" bindtap="section" data-section="films">成片<text>{{filmCount}}</text></button></view>
  <block wx:if="{{section === 'materials'}}"><view class="page-heading"><text>我的素材<text class="count">{{count}}</text></text><button size="mini" class="secondary" bindtap="upload" loading="{{uploading}}" disabled="{{uploading}}"><image class="ui-icon" src="{{onPrimary.upload}}" mode="aspectFit"/>添加</button></view><view class="subtitle">图片和视频可混选，也可分批追加。</view><button size="mini" class="small-button live-help" bindtap="livePhotoHelp">如何导入实况照片？</button><view class="filters"><button size="mini" class="{{filter === 'all' ? 'selected' : ''}}" data-kind="all" bindtap="filter">全部</button><button size="mini" class="{{filter === 'video' ? 'selected' : ''}}" data-kind="video" bindtap="filter">视频</button><button size="mini" class="{{filter === 'image' ? 'selected' : ''}}" data-kind="image" bindtap="filter">图片</button><button size="mini" class="{{filter === 'audio' ? 'selected' : ''}}" data-kind="audio" bindtap="filter">音频</button></view><view wx:if="{{uploading}}" class="notice">{{uploadText}}</view>
  <view class="collection-tabs"><button size="mini" class="{{collection === 'library' ? 'selected' : ''}}" bindtap="collection" data-collection="library">可用素材</button><button size="mini" class="{{collection === 'clips' ? 'selected' : ''}}" bindtap="collection" data-collection="clips">镜头归档</button><button size="mini" class="{{collection === 'production' ? 'selected' : ''}}" bindtap="collection" data-collection="production">制作归档 {{productionCount || ''}}</button></view>
  <input class="input media-search" placeholder="搜索名称或镜头标签" value="{{query}}" bindinput="search" maxlength="80"/>
  <button size="mini" class="film-entry" bindtap="film">进入拉片工作台 <text>分析原片，筛选镜头后归档复用 ›</text></button>
  <view wx:if="{{collection === 'production'}}" class="quiet collection-note">自动生成的教学分镜等过程文件保留在这里，不再混入可用素材；需要时可恢复。</view>
  <view wx:if="{{!items.length && !loadingState}}" class="empty"><image class="empty-mark empty-icon" src="{{icons.library}}" mode="aspectFit"/><text class="title">{{query || filter !== 'all' ? '没有找到匹配的素材' : collection === 'production' ? '还没有制作归档' : collection === 'clips' ? '还没有归档镜头' : '把素材带进来'}}</text><view class="muted">{{collection === 'clips' ? '在拉片工作台选择有用的原片镜头，归档后可用于创作。' : '上传影片、图片或音频，也可通过拉片整理可复用镜头。'}}</view></view>
  <view class="card-grid material-grid"><view wx:for="{{items}}" wx:key="id" class="media-tile"><view bindtap="play" data-id="{{item.id}}"><image wx:if="{{item.cover}}" class="media-cover" src="{{item.cover}}" mode="aspectFill" lazy-load data-id="{{item.id}}" binderror="coverError"/><view wx:else class="media-cover media-placeholder"><view class="placeholder-sun"/><view class="placeholder-hill"/><image class="placeholder-icon" src="{{item.kind === 'video' ? placeholderIcons.films : item.kind === 'audio' ? placeholderIcons.voice : placeholderIcons.library}}" mode="aspectFit"/><text>{{item.kind === 'video' ? '视频' : item.kind === 'audio' ? '音频' : '图片'}}</text></view><button size="mini" wx:if="{{item.coverError}}" class="small-button" catchtap="retryCover">重试缩略图</button><view class="media-info"><text class="media-name">{{item.name}}</text><text class="quiet">{{item.production ? '制作过程文件' : item.archivedClip ? '已归档的原片镜头' : ''}}</text><text class="muted">{{item.duration}}</text><text class="date">{{item.date}}</text><view class="clip-tags" wx:if="{{item.tags.length}}"><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}} </text></view></view></view>
    <view class="media-actions"><button size="mini" wx:if="{{!item.production}}" class="small-button" bindtap="use" data-id="{{item.id}}">用来创作 ↗</button><button size="mini" wx:if="{{item.kind === 'video' && !item.production}}" class="small-button" bindtap="film" data-id="{{item.id}}">拉片</button><button size="mini" wx:if="{{item.production || item.productionSource}}" class="small-button" bindtap="moveCollection" data-id="{{item.id}}" data-collection="{{item.production ? 'library' : 'production'}}">{{item.production ? '恢复' : '归档'}}</button><button size="mini" class="delete-button" bindtap="remove" data-id="{{item.id}}">删除</button></view>
  </view></view><button size="mini" wx:if="{{more}}" class="secondary load-more" bindtap="more">加载更多</button>
  </block>
  <block wx:else>
    <view class="page-heading"><text>我的成片<text class="count">{{count}}</text></text><button size="mini" class="small-button" bindtap="create">去创作 ↗</button></view>
    <view wx:for="{{jobs}}" wx:key="id" class="panel running-card" bindtap="session" data-id="{{item.id}}"><view class="row spread"><text class="title">✦ {{item.label}}</text><text class="tag">{{item.progress}}%</text></view><view class="muted">{{item.stage}}</view><progress percent="{{item.progress}}" stroke-width="3" activeColor="{{progressColor}}" backgroundColor="{{progressTrack}}"/><text class="quiet">查看制作过程 →</text></view>
    <view class="filters"><button size="mini" class="{{filter === 'all' ? 'selected' : ''}}" data-kind="all" bindtap="filter">全部</button><button size="mini" class="{{filter === 'video' ? 'selected' : ''}}" data-kind="video" bindtap="filter">视频</button><button size="mini" class="{{filter === 'image' ? 'selected' : ''}}" data-kind="image" bindtap="filter">图片</button><button size="mini" class="{{filter === 'audio' ? 'selected' : ''}}" data-kind="audio" bindtap="filter">音频</button><button size="mini" class="{{filter === 'sticker-pack' ? 'selected' : ''}}" data-kind="sticker-pack" bindtap="filter">表情包</button><button size="mini" class="{{filter === 'game' ? 'selected' : ''}}" data-kind="game" bindtap="filter">互动</button></view>
    <input class="input media-search" placeholder="搜索作品名称" value="{{query}}" bindinput="search" maxlength="80"/>
    <view wx:if="{{!items.length && !loadingState}}" class="empty"><image class="empty-mark empty-icon" src="{{icons.films}}" mode="aspectFit"/><text class="title">{{query || filter !== 'all' ? '没有找到匹配的作品' : '第一支作品，等你开启'}}</text><view class="muted">{{query || filter !== 'all' ? '试试其他名称，或切换筛选条件。' : '制作完成后，会自动同步到这里。'}}<view wx:if="{{!query && filter === 'all'}}">离开页面也不会中断已经提交的制作任务。</view></view><button size="mini" class="secondary" bindtap="create">去创作 ↗</button></view>
    <view class="card-grid film-grid"><view wx:for="{{items}}" wx:key="id" class="media-tile" bindtap="play" data-id="{{item.id}}"><image wx:if="{{item.cover}}" class="media-cover" src="{{item.cover}}" mode="aspectFill" lazy-load data-id="{{item.id}}" binderror="coverError"/><view wx:else class="media-cover media-placeholder"><view class="placeholder-sun"/><view class="placeholder-hill"/><image class="placeholder-icon" src="{{item.kind === 'image' ? placeholderIcons.library : item.kind === 'audio' ? placeholderIcons.voice : placeholderIcons.films}}" mode="aspectFit"/><text>{{item.kind === 'video' ? '视频' : item.kind === 'audio' ? '音频' : item.kind === 'game' ? '互动作品' : item.kind === 'sticker-pack' ? '表情套装' : '图片'}}</text></view><button size="mini" wx:if="{{item.coverError}}" class="small-button" catchtap="retryCover">重试缩略图</button><view class="media-info"><text class="media-name">{{item.name}}</text><view class="row spread"><text class="muted">{{item.duration || 'v' + item.version}}</text><text class="tag">{{item.status}}</text></view><text class="date">{{item.date}}</text></view></view></view>
    <button size="mini" wx:if="{{more}}" class="secondary load-more" bindtap="more">加载更多</button>
  </block>
</view><privacy-dialog id="privacy" />
</view>
