.resource-home .wallet-label, .resource-home .wallet-balance { display:block; }
.resource-home .wallet-balance { margin-top:6rpx; }
.resource-entries { display:flex; flex-direction:column; gap:16rpx; }
.resource-entry {
  display:flex;
  align-items:center;
  gap:16rpx;
  min-height:96rpx;
  padding:16rpx 24rpx;
  border:1rpx solid var(--lm-line);
  border-radius:24rpx;
  background:var(--lm-paper);
  color:var(--lm-ink);
}
.resource-entry-pressed { background:var(--lm-soft); }
.theme-surface .resource-entry-icon { width:42rpx; height:42rpx; flex-basis:42rpx; }
.resource-entry-label { flex:1; font-size:30rpx; font-weight:600; }
.resource-entry-count { color:var(--lm-muted); font-size:24rpx; }
.resource-entry-arrow { color:var(--lm-gold); font-size:32rpx; line-height:1; }
.resource-version { text-align:center; margin:36rpx 0; }
