.resource-screen { padding:28rpx 24rpx; }
.resource-heading { display:flex; justify-content:space-between; align-items:center; margin:12rpx 0 26rpx; }
.resource-eyebrow { color:var(--lm-muted); font-size:18rpx; letter-spacing:2rpx; }
.resource-title { font-size:40rpx; font-weight:600; margin-top:12rpx; }
.theme-surface .add-resource { width:auto; max-width:none; margin:0; padding:18rpx 22rpx; border-radius:26rpx; font-size:24rpx; color:var(--lm-on-accent); background:var(--lm-accent); }
.resource-tabs { display:flex; border-bottom:1rpx solid var(--lm-line); margin-bottom:24rpx; }
.theme-surface .resource-tab { position:relative; width:auto; max-width:none; margin:0 40rpx 0 0; padding:18rpx 2rpx 24rpx; font-size:32rpx; color:var(--lm-muted); border-radius:0; }
.resource-tab text { margin-left:12rpx; font-size:22rpx; }
.theme-surface .resource-tab.selected { color:var(--lm-ink); font-weight:600; }
.resource-tab.selected::before { content:''; position:absolute; bottom:0; left:2rpx; width:48rpx; height:6rpx; border-radius:6rpx; background:var(--lm-accent); }
.theme-surface .resource-screen .media-search { height:80rpx; margin:0 0 16rpx; padding:0 24rpx; border-radius:22rpx; font-size:25rpx; }
.resource-filter-scroll { width:100%; height:76rpx; white-space:nowrap; overflow:hidden; margin:0 0 12rpx; }
/* Keep this row independent of the shared .filters margins and native sizing. */
.resource-kinds { display:inline-flex; align-items:center; vertical-align:top; min-width:100%; height:72rpx; margin:0; padding:0; }
.theme-surface .resource-kind { box-sizing:border-box; display:flex; align-items:center; justify-content:center; flex:0 0 auto; width:auto; max-width:none; height:64rpx; padding:0 22rpx; margin:0 12rpx 0 0; line-height:1.25; white-space:nowrap; font-size:24rpx; color:var(--lm-muted); border:1rpx solid var(--lm-line); border-radius:32rpx; background:transparent; }
.resource-kind text { font-size:20rpx; margin-left:8rpx; opacity:.8; }
.theme-surface .resource-kind.selected { color:var(--lm-on-accent); background:var(--lm-accent); border-color:var(--lm-accent); font-weight:600; }
.collection-tabs { display:flex; align-items:center; flex-wrap:wrap; margin:0 0 14rpx; }
.theme-surface .collection-tabs button { width:auto; max-width:none; margin:0 26rpx 0 0; padding:12rpx 0; color:var(--lm-muted); font-size:23rpx; line-height:1.5; border-radius:0; }
.theme-surface .collection-tabs .selected { color:var(--lm-accent); font-weight:600; }
.resource-tools { display:flex; justify-content:space-between; border-top:1rpx solid var(--lm-line); padding-top:12rpx; }
.theme-surface .resource-tools button { margin:0; padding:8rpx 0; font-size:21rpx; color:var(--lm-muted); }
.collection-note { margin:16rpx 0; }
.result-summary { display:flex; justify-content:space-between; margin:20rpx 0 18rpx; font-size:21rpx; color:var(--lm-muted); }
.theme-surface .resource-grid { display:flex; flex-wrap:wrap; align-items:flex-start; gap:0; margin:0 -5rpx; }
.theme-surface .resource-grid .media-tile { box-sizing:border-box; width:33.3333%; flex:0 0 33.3333%; min-width:0; border:0; border-radius:0; background:transparent; padding:0 5rpx; margin:0 0 20rpx; overflow:visible; }
.tile-preview { position:relative; width:100%; height:224rpx; border-radius:12rpx; overflow:hidden; background:var(--lm-soft); }
.theme-surface .resource-grid .media-cover { display:block; width:100%; height:100%; }
.theme-surface .resource-grid .media-placeholder { display:flex; flex-direction:column; align-items:center; justify-content:center; background:linear-gradient(145deg,var(--lm-soft),var(--lm-paper)); font-size:21rpx; color:var(--lm-muted); }
.resource-grid .placeholder-icon { position:static; width:52rpx; height:52rpx; margin-bottom:12rpx; }
.tile-duration { position:absolute; bottom:0; left:0; right:0; padding:22rpx 10rpx 10rpx; font-size:20rpx; color:#fff; background:linear-gradient(transparent,rgba(35,24,20,.6)); }
.tile-marker { position:absolute; top:10rpx; left:10rpx; padding:3rpx 8rpx; font-size:18rpx; border-radius:8rpx; color:var(--lm-ink); background:var(--lm-paper); }
.tile-caption { display:flex; align-items:center; min-height:74rpx; }
.theme-surface .resource-grid .media-name { flex:1; min-width:0; display:block; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-size:23rpx; color:var(--lm-ink); }
.theme-surface .tile-menu { width:52rpx; flex:0 0 52rpx; max-width:none; height:80rpx; margin:0; padding:0; line-height:80rpx; font-size:30rpx; color:var(--lm-muted); background:transparent; }
.theme-surface .retry-thumb { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); padding:8rpx 14rpx; font-size:20rpx; color:var(--lm-ink); background:var(--lm-paper); }
.running-card { margin:22rpx 0; }.running-card progress { margin:18rpx 0; }.load-more { margin:30rpx auto; }.empty .secondary { width:auto; margin:24rpx auto 0; }
.theme-surface .tile-menu { width:72rpx; flex-basis:72rpx; height:88rpx; line-height:88rpx; }
.folder-scroll { margin:14rpx 0;white-space:nowrap; }.folder-row { display:flex;gap:12rpx; }.folder-row button { flex:none;margin:0;padding:8rpx 16rpx;font-size:24rpx;background:var(--lm-paper);color:var(--lm-muted); }.folder-row .selected { background:var(--lm-soft);color:var(--lm-accent); }.folder-picker { position:fixed;z-index:50;inset:0;background:#0006;display:flex;align-items:flex-end; }.folder-sheet { width:100%;padding:30rpx 24rpx 65rpx;background:var(--lm-paper);border-radius:24rpx 24rpx 0 0; }.folder-sheet button { margin:16rpx 0;width:100%;font-size:26rpx; }
.resource-selecting { padding-bottom:200rpx; }
.result-summary { align-items:center; }
.theme-surface .resource-select-entry { width:auto; margin:0; padding:12rpx 20rpx; font-size:23rpx; color:var(--lm-accent); background:var(--lm-soft); }
.tile-selected { outline:3rpx solid var(--lm-accent); outline-offset:-3rpx; }
.tile-check { position:absolute; top:10rpx; right:10rpx; width:44rpx; height:44rpx; display:flex; justify-content:center; align-items:center; border:3rpx solid #fff; border-radius:50%; background:#23181465; color:#fff; font-weight:600; font-size:27rpx; pointer-events:none; }
.tile-check.checked { background:var(--lm-accent); }
.resource-selection { position:fixed; z-index:40; bottom:0; left:0; right:0; padding:12rpx 24rpx; background:var(--lm-paper); border-top:1rpx solid var(--lm-line); }
.resource-selection-actions { display:flex; align-items:center; gap:16rpx; }
.theme-surface .resource-selection-actions button { width:auto; min-height:76rpx; margin:0; padding:12rpx 20rpx; font-size:25rpx; color:var(--lm-ink); }
.resource-selection-count { flex:1; font-size:24rpx; color:var(--lm-muted); }
.theme-surface .resource-selection-actions .resource-delete { background:#a83e32; color:#fff; }
.theme-surface .resource-selection-actions button[disabled] { opacity:.45; }
.resource-delete-error { display:block; margin:6rpx 0; color:var(--lm-accent); font-size:22rpx; }
