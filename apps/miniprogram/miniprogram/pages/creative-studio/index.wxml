<view class="cs theme-surface theme-{{theme}}"><view class="cs-workspace-title">创作工作台</view>
 <scroll-view scroll-x class="cs-tabs"><button size="mini" wx:for="{{['note','character','scene','mv','template']}}" wx:key="*this" data-id="{{item}}" bindtap="mode" class="{{mode===item?'cs-active':''}}">{{item==='note'?'笔记':item==='character'?'人物':item==='scene'?'场景':item==='mv'?'音乐MV':'我的模板'}}</button></scroll-view>
 <view class="cs-error" wx:if="{{error}}">{{error}}</view>
 <view class="cs-project-context"><view><text class="cs-meta">当前项目</text><view class="cs-current">{{title||'新建灵感'}}</view></view><view class="cs-save-status">{{editing||!noteId?'未保存':'已保存'}}<text wx:if="{{revision}}"> · v{{revision}}</text></view></view><view class="cs-hint">{{mode==='mv'?'上传音频 → 识别 → 规划分镜':mode==='character'||mode==='scene'?'描述想法 → 生成设定图 → 存为资产':mode==='template'?'原作品 → 模板草稿 → 修改后复用':'记录灵感 · 随手画 · 轻喵整理'}}</view>
 <button wx:if="{{mode==='mv'}}" size="mini" class="cs-primary" bindtap="recreate">原素材复刻MV ↗</button><view class="cs-editor-card"><view class="cs-card-heading">{{mode==='mv'?'MV制作要求':mode==='character'?'人物设定':mode==='scene'?'场景设定':mode==='template'?'模板草稿':'灵感编辑'}}<text>{{text.length}}字 · {{attachmentIds.length}}个素材</text></view><input value="{{title}}" data-field="title" bindinput="field" placeholder="标题" maxlength="80"/>
 <textarea value="{{text}}" data-field="text" bindinput="field" placeholder="记下想法…" maxlength="12000"/>
 <view class="cs-actions"><button size="mini" bindtap="upload" disabled="{{busy}}">图片/视频</button><button size="mini" bindtap="upload" data-kind="audio" disabled="{{busy}}">语音/音频</button><button size="mini" bindtap="pick">已有素材</button><button size="mini" bindtap="draw">手绘</button></view>
 <view wx:if="{{drawing}}" class="cs-drawing"><view class="cs-sketch-surface"><canvas canvas-id="idea" style="width:300px;height:200px" disable-scroll catchtouchstart="drawStart" catchtouchmove="drawMove" catchtouchend="drawEnd" catchtouchcancel="drawEnd"/></view><view class="cs-actions"><button size="mini" bindtap="undoDraw">撤销一笔</button><button size="mini" bindtap="exportDraw" disabled="{{busy}}">转为素材</button></view></view>
 <view class="cs-item" wx:for="{{attached}}" wx:key="id"><image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFit"/><view class="cs-grow"><text>{{item.name}}</text><text class="cs-meta">{{item.analyzed?'已识别':''}}</text><button size="mini" wx:if="{{(mode==='character'||mode==='scene')&&item.kind==='image'}}" data-id="{{item.id}}" bindtap="asset">存为{{mode==='character'?'人物':'场景'}}资产</button></view><button size="mini" data-id="{{item.id}}" bindtap="removeAttachment">移除</button></view>
 <view wx:if="{{hasAudio||sessionId}}" class="cs-actions"><button wx:if="{{hasAudio}}" size="mini" bindtap="analyze" disabled="{{busy}}">识别音频</button><button wx:if="{{hasAudio}}" size="mini" bindtap="useTranscript">填入转写</button><button size="mini" bindtap="openSession" wx:if="{{sessionId}}">查看项目 ↗</button></view>
 <view class="cs-actions"><button size="mini" bindtap="save" disabled="{{busy}}">保存</button><button size="mini" class="cs-primary" bindtap="agent" loading="{{busy}}" disabled="{{busy}}">{{mode==='mv'?'规划分镜':mode==='character'||mode==='scene'?'生成设定图':mode==='template'?'提炼模板':'轻喵整理'}}</button><button size="mini" wx:if="{{mode==='template'}}" bindtap="useTemplate">用此模板</button><button size="mini" bindtap="copy">复制</button></view>
 </view><view wx:if="{{mode==='character'||mode==='scene'}}" class="cs-library-card"><view class="cs-heading">我的{{mode==='character'?'人物':'场景'}}</view><view class="cs-item" wx:for="{{assets}}" wx:key="id"><image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFit"/><text class="cs-grow">{{item.name}}</text><button size="mini" data-id="{{item.id}}" bindtap="assetMenu">管理</button></view><view wx:if="{{!assets.length}}" class="cs-meta">选择一张已有图片，存为资产</view></view>
 <view class="cs-library-card"><view class="cs-heading">{{mode==='template'?'模板草稿':mode==='mv'?'MV笔记':'我的笔记'}}<button size="mini" bindtap="newNote">＋ 新建</button></view>
 <input class="cs-search" placeholder="搜索标题或内容" value="{{search}}" bindinput="searchNotes"/><view class="cs-item" wx:for="{{shownNotes}}" wx:key="id"><button size="mini" class="cs-grow" data-id="{{item.id}}" bindtap="openNote">{{item.title}}</button><button size="mini" data-id="{{item.id}}" bindtap="removeNote">删除</button></view>
 <view wx:if="{{!shownNotes.length}}" class="cs-meta">暂无匹配内容</view></view><view class="cs-picker" wx:if="{{picking}}"><view class="cs-heading">选择素材<button size="mini" bindtap="closePicker">完成</button></view><scroll-view scroll-y style="height:60vh"><view class="cs-item" wx:for="{{picker}}" wx:key="id"><image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFit"/><button size="mini" class="cs-grow" data-id="{{item.id}}" bindtap="attach">{{item.name}}</button></view></scroll-view></view>
</view>
