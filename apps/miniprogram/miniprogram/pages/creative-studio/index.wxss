.cs{min-height:100vh;box-sizing:border-box;background:#fff9ee;color:#69473c;padding:14px 16px 40px;font-size:14px}.cs-tabs{white-space:nowrap;margin-bottom:12px}.cs button{margin:0;border:0;border-radius:8px;background:#f4e3c6;color:#a74e2a;font-size:12px;padding:6px 10px;line-height:1.7;max-width:100%;box-sizing:border-box}.cs button::after{border:0}.cs-tabs button{display:inline-block;margin-right:8px}.cs .cs-active,.cs .cs-primary{background:#c9612f;color:#fff}.cs-hint,.cs-meta{font-size:12px;color:#947052;margin:8px 0}.cs-error{color:#b2462b;font-size:12px}.cs input,.cs textarea{box-sizing:border-box;width:100%;background:#fffdf8;border:1px solid #e6d7bd;border-radius:10px;margin:10px 0;padding:10px;font-size:14px}.cs input{height:44px}.cs textarea{height:160px}.cs-actions{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}.cs-drawing{padding:6px 0;overflow:hidden}.cs-drawing canvas{border:1px solid #e6d7bd;background:#fffdf8}.cs-item{display:flex;gap:8px;align-items:center;padding:10px 0;border-bottom:1px solid #e6d7bd}.cs-item image{width:48px;height:48px;flex-shrink:0;border-radius:7px}.cs-grow{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis}.cs-item .cs-grow{text-align:left}.cs-heading{display:flex;justify-content:space-between;align-items:center;margin:20px 0 8px;font-size:15px}.cs-picker{position:fixed;inset:20vh 0 0;background:#fff9ee;padding:16px;z-index:30;box-shadow:0 -10px 30px #0003;border-radius:18px 18px 0 0}.cs.theme-rich{background:#302720;color:#f5e8d9}.cs.theme-rich input,.cs.theme-rich textarea{background:#241d18;color:#f5e8d9}

.cs input{padding:0 10px;line-height:44px}

.cs{padding:12px 12px 40px}.cs-workspace-title{font-size:19px;font-weight:600;margin:0 0 12px}.cs-project-context{display:flex;gap:10px;align-items:center;justify-content:space-between;background:#fffdf8;border:1px solid #e6d7bd;border-radius:12px;padding:12px;margin:8px 0}.cs-current{font-size:15px;font-weight:600;max-width:210px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.cs-save-status{font-size:11px;background:#f4e3c6;border-radius:6px;padding:5px 8px;white-space:nowrap}.cs-editor-card,.cs-library-card{background:#fffdf8;border:1px solid #e6d7bd;border-radius:12px;padding:12px;margin-bottom:12px}.cs-card-heading{display:flex;justify-content:space-between;align-items:center;font-size:14px;font-weight:600}.cs-card-heading text{font-size:11px;font-weight:400;color:#947052}.cs-editor-card textarea{height:180px}.cs-library-card .cs-heading{margin:0 0 8px}.cs-library-card .cs-item:last-child{border-bottom:0}.cs-drawing{margin:0 -6px}.cs.theme-rich .cs-project-context,.cs.theme-rich .cs-editor-card,.cs.theme-rich .cs-library-card{background:#241d18;border-color:#5b4636}.cs.theme-rich .cs-save-status{background:#483426}.cs input.cs-search{height:36px;line-height:36px;font-size:12px}
