.profile-top { display: flex; align-items: center; gap: 25rpx; margin: 20rpx 0 40rpx; }.profile-avatar { width: 98rpx; height: 98rpx; display: flex; align-items: center; justify-content: center; border-radius: 30rpx; background: #fae3d3; color: #c77652; font-size: 40rpx; font-weight: 650; }.profile-name { font-size: 36rpx; font-weight: 650; margin-bottom: 8rpx; }.stats { display: flex; justify-content: space-around; margin-bottom: 46rpx; }.stats view { text-align: center; }.stats text { display: block; font-size: 23rpx; color: #a08f80; }.stats text:first-child { font-size: 38rpx; color: #584737; margin-bottom: 8rpx; }.wallet-card { width: 100%; display: flex; align-items: center; justify-content: space-between; background: #f8edda; border: 1rpx solid #eadebc; padding: 30rpx; border-radius: 28rpx; margin-bottom: 32rpx; text-align: left; }.wallet-label { display: block; font-size: 23rpx; color: #9b8661; }.wallet-balance { display: block; font-size: 44rpx; color: #78603e; font-weight: 650; margin-top: 6rpx; }.wallet-action { font-size: 25rpx; color: #a4814b; }.profile-links { padding: 12rpx 30rpx; }.profile-version { text-align: center; margin: 36rpx 0; }.logout { color: #b18467; font-size: 25rpx; margin: 24rpx auto; padding: 20rpx; }
