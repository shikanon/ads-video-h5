<view class="screen"><view class="profile-top"><view class="profile-avatar">轻</view><view><view class="profile-name">{{user.displayName || '微信创作者'}}</view><text class="muted">微信账号</text></view></view><view class="stats"><view><text>{{films}}</text><text>成片</text></view><view><text>{{media}}</text><text>素材</text></view><view><text>{{sessions}}</text><text>会话</text></view></view>
  <button class="wallet-card" bindtap="navigate" data-page="credits"><view><text class="wallet-label">我的积分</text><text class="wallet-balance">{{balance}}</text></view><view class="wallet-action">{{canCheckIn ? '签到领取' : '查看明细'}} →</view></button>
  <view class="panel nickname-panel"><view class="label">微信昵称（选填）</view><view class="row"><input class="input grow" type="nickname" value="{{nickname}}" bindinput="nickname" bindblur="nickname" placeholder="填写或选择微信昵称" maxlength="40" /><button class="small-button" loading="{{savingName}}" disabled="{{savingName}}" bindtap="saveName">保存</button></view></view>
  <view class="panel profile-links"><button class="link-row" bindtap="navigate" data-page="history"><text>会话历史</text><text class="arrow">›</text></button><button class="link-row" bindtap="navigate" data-page="settings"><text>设置</text><text class="arrow">›</text></button><button class="link-row" bindtap="legal" data-type="privacy"><text>隐私说明</text><text class="arrow">›</text></button><button class="link-row" bindtap="legal" data-type="terms"><text>用户协议</text><text class="arrow">›</text></button></view><view class="quiet profile-version">轻剪 · 微信小程序测试版<view>微信账号独立保存作品与积分。</view></view><button class="logout" loading="{{loggingOut}}" disabled="{{loggingOut}}" bindtap="logout">退出登录</button>
</view><privacy-dialog id="privacy" />
