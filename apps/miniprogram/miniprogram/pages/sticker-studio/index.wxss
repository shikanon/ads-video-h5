.eyebrow { font-size:22rpx; color:var(--lm-accent); margin-bottom:18rpx; }.intro { margin:18rpx 0 28rpx; }.section-title { font-size:29rpx; font-weight:600; margin-bottom:20rpx; }.mode-tabs { display:flex; margin:22rpx 0; }.theme-surface .mode-tabs button { flex:1; margin:0 12rpx 0 0; padding:18rpx; font-size:27rpx; border-radius:24rpx; }.mode-tabs .selected { color:var(--lm-on-accent); background:var(--lm-accent); }.field-label { margin:24rpx 0 12rpx; font-size:24rpx; }.style-input { width:100%; min-height:100rpx; }.studio-page .panel { margin-bottom:26rpx; }.studio-page .primary,.studio-page .secondary { margin-top:22rpx; }.fee-note { font-size:22rpx; line-height:1.8; margin:22rpx 0; }.reference-scroll { height:222rpx; width:100%; margin:20rpx 0; white-space:nowrap; }.reference-track { display:inline-flex; }.theme-surface .reference-card { width:150rpx; flex:0 0 150rpx; margin:0 14rpx 0 0; padding:8rpx; border:2rpx solid var(--lm-line); border-radius:18rpx; white-space:normal; }.reference-card image,.reference-placeholder { width:130rpx; height:130rpx; }.reference-placeholder { display:flex; align-items:center; justify-content:center; background:var(--lm-soft); font-size:22rpx; }.reference-card text { display:block; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; font-size:21rpx; }.theme-surface .reference-card.selected { border-color:var(--lm-accent); background:var(--lm-soft); }.sample-grid { display:flex; margin:20rpx -6rpx; }.theme-surface .sample-card { width:33.33%; flex:0 0 33.33%; margin:0; padding:6rpx; border-radius:16rpx; background:var(--lm-soft); }.sample-card image { width:100%; height:200rpx; }.sample-card text { font-size:22rpx; }.studio-page .row { padding:16rpx 0; }.theme-surface .project-row { display:block; width:100%; max-width:none; padding:24rpx; text-align:left; }.project-row text { display:block; }.project-row .muted { margin-top:12rpx; font-size:22rpx; }.preview-mask { position:fixed; inset:0; z-index:60; background:rgba(30,20,20,.8); display:flex; align-items:center; justify-content:center; }.preview-mask image { width:88vw; height:78vh; background:var(--lm-paper); border-radius:26rpx; }
