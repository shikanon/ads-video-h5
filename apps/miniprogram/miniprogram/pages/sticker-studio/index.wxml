<view class="screen theme-surface theme-{{theme}} studio-page">
  <view class="eyebrow">轻喵创作工坊 · 新角色表情</view><view class="title">让你的角色，表达每一种心情。</view>
  <view class="muted intro">上传角色 → 点选一种候选画风 → 确认3个样张 → 制作24个动作。</view>
  <view wx:if="{{fromTemplate}}" class="notice">上传自己的角色，制作同款表情。</view>
  <view wx:if="{{guest}}" class="empty"><text>登录后使用自己的积分制作表情。</text><button class="primary" bindtap="login">登录，制作我的角色</button></view>
  <view wx:if="{{checking}}" class="muted">正在检查制作能力…</view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="load">刷新状态</button></view>
  <view wx:if="{{!available && !checking && !error}}" class="notice">图片模型尚未配置，请联系管理员。已完成的套装仍可查看。</view>
  <block wx:if="{{available && !project}}">
    <view wx:if="{{newSessionNeeded}}" class="notice">已保留角色图、名称和画风。点击生成样张时，会使用新的工作会话。</view>
    <view class="mode-tabs"><button class="{{mode === 'dynamic' ? 'selected' : ''}}" bindtap="mode" data-mode="dynamic">动态表情</button><button class="{{mode === 'static' ? 'selected' : ''}}" bindtap="mode" data-mode="static">静态表情</button></view>
    <view class="panel"><view class="section-title">1. 角色与画风</view><button class="secondary" bindtap="upload" loading="{{uploading}}" disabled="{{uploading || submitting}}">上传一张角色图 ＋</button><view class="muted">也可从已有图片中选择。只使用你选中的角色图。</view>
      <scroll-view wx:if="{{references.length}}" scroll-x class="reference-scroll"><view class="reference-track"><button wx:for="{{references}}" wx:key="id" class="reference-card {{referenceId === item.id ? 'selected' : ''}}" bindtap="reference" data-id="{{item.id}}" aria-label="选择{{item.name}}"><image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFit" data-id="{{item.id}}" binderror="coverError"/><view wx:else class="reference-placeholder">角色图</view><text>{{item.name}}</text></button></view></scroll-view>
      <view class="muted">{{referenceName ? '已选择：' + referenceName : '尚未选择角色图'}}</view><view class="field-label">套装名称</view><input class="input" value="{{name}}" maxlength="16" bindinput="name" placeholder="例如：小橘的日常心情"/>
      <view class="field-label">选择画风</view><scroll-view scroll-x class="style-scroll"><view class="style-track"><button wx:for="{{styles}}" wx:key="id" class="style-card {{styleId === item.id ? 'selected' : ''}}" bindtap="chooseStyle" data-id="{{item.id}}"><image wx:if="{{item.sample}}" src="{{item.sample}}" mode="aspectFit"/><text>{{item.name}}</text></button></view></scroll-view><view class="field-label">补充角色与画风要求</view><textarea class="input style-input" value="{{style}}" maxlength="240" bindinput="changeStyle" auto-height/>
      <view class="muted fee-note">{{styleId === 'lightmao' ? '先制作两种角色画风候选，选定一种后另行制作3个动作样张。' : mode === 'dynamic' ? '先制作1张角色底稿，再生成3个动态样张。' : '先生成3张静态表情。'}}本阶段 {{styleId === 'lightmao' ? pricing.styleCandidates : mode === 'dynamic' ? pricing.dynamicSamples : pricing.staticSamples}} 积分（{{pricing.pointsPerImage}} 积分/张）。每个阶段需你点击继续，未通过的图片不扣图片积分。</view>
      <button class="primary start-samples" bindtap="start" loading="{{submitting}}" disabled="{{submitting || busy || uploading}}">{{busy ? '当前会话有任务进行中' : styleId === 'lightmao' ? '制作两种候选画风 · ' + pricing.styleCandidates + '积分' : '生成3个样张 · ' + (mode === 'dynamic' ? pricing.dynamicSamples : pricing.staticSamples) + '积分'}}</button>
    </view>
  </block>
  <view wx:if="{{project.recipe.styleSelection}}" class="panel">
    <view class="section-title">2. 选择一种画风</view><view class="muted">这两种画风都参考轻喵原有24张表情。你想选择哪一种？点开图片比较，再点选一种制作样张。</view>
    <view class="style-choice-grid"><view wx:for="{{candidates}}" wx:key="id" class="style-choice-card {{project.styleSelection.id === item.id ? 'chosen' : ''}}">
      <button bindtap="previewCandidate" data-id="{{item.id}}"><image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFit"/><text wx:else>点击查看画风</text><view>{{item.name}}</view></button>
      <button class="secondary" wx:if="{{!project.styleSelection || project.styleSelection.id === item.id && !projectJob}}" bindtap="selectCandidate" data-id="{{item.id}}" disabled="{{submitting || busy || !quote || candidates.length !== 2}}">选择这款，制作样张 · {{quote ? quote.points : '读取费用中'}}积分</button>
    </view></view>
    <view wx:if="{{project.styleSelection}}" class="notice">已锁定所选画风。后续所有样张和整套动作沿用同一角色绘稿，不会混用另一种画风。</view>
    <button wx:if="{{project.styleSelection && projectJob.phase === 'styles' && !projectJob.active}}" class="primary" bindtap="selectCandidate" data-id="{{project.styleSelection.id}}" disabled="{{submitting || busy || !quote}}">继续制作3个样张 · {{quote ? quote.points : '读取费用中'}}积分</button>
  </view>
  <view wx:if="{{project}}" class="panel"><view class="section-title">{{project.recipe.styleSelection ? '3' : '2'}}. 确认{{project.recipe.mode === 'static' ? '静态' : '动态'}}样张</view><view class="muted">{{project.recipe.name}} · 点击样张查看，检查角色、画风、透明边缘和动作。</view>
    <view wx:if="{{projectSessionUnavailable}}" class="notice">{{projectSessionReason}}，角色图和设定仍已保留。可查看任务记录，或调整设定后在新会话重新制作样张。</view>
    <view wx:if="{{projectTemplateChanged}}" class="notice">制作方式已更新，请点“调整设定，重新制作样张”，保留角色图和画风后提交新任务。</view>
    <view wx:if="{{projectJob}}" class="notice">{{projectJob.status}}<view>{{projectJob.stage}}</view><view wx:if="{{projectJob.error}}">{{projectJob.error}}</view></view>
    <view wx:if="{{!project.previewHash && !projectTemplateChanged && (!project.recipe.styleSelection || project.styleSelection)}}" class="notice">{{projectSessionUnavailable ? '尚无可用样张，可保留设定重新制作。' : projectJob.retryable ? '样张还没有生成成功。可直接重试本任务，或调整设定后另做一组样张。' : '样张尚未完成，可查看会话任务。'}}</view>
    <block wx:if="{{projectJob.retryable}}"><view class="muted fee-note">重试会继续当前阶段，复用已生成的图片。</view><button class="primary retry-project" bindtap="retry" loading="{{submitting}}" disabled="{{submitting || busy || !quote}}">{{projectJob.phase === 'styles' ? '继续候选画风' : projectJob.phase === 'batch' ? '继续剩余动作' : '重试这3个样张'}} · {{quote ? quote.points : '读取费用中'}}积分</button></block>
    <view wx:if="{{quote && balance < quote.points}}" class="error">本阶段需要 {{quote.points}} 积分，当前可用 {{balance}} 积分，请先到「我的积分」签到或查看余额。</view><view wx:if="{{quoteError}}" class="error">{{quoteError}}</view><view wx:if="{{quote}}" class="muted fee-note">本阶段 {{quote.points}} 积分 · 最多新增 {{quote.imageCount}} 张。已生成图片会保留，续做仅计算未生成部分；服务器空间故障阶段的扣款会退回。</view>
    <view class="sample-grid"><button wx:for="{{samples}}" wx:key="id" class="sample-card" bindtap="preview" data-id="{{item.id}}"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit"/><text wx:else>点击加载预览</text></button></view>
    <block wx:if="{{project.previewHash && !project.ready && !projectSessionUnavailable && !projectTemplateChanged}}"><view class="row spread"><text>同步制作分享视频</text><switch checked="{{makeVideo}}" color="#c9612f" bindchange="video"/></view><view wx:if="{{makeVideo}}" class="row spread"><text>配乐</text><switch checked="{{bgm}}" color="#c9612f" bindchange="music"/></view><view class="muted fee-note">确认后复用已完成的动作，仅继续制作剩余动作。静态套装只交付静态PNG；动态套装交付GIF、WebP、APNG和静态PNG。</view><button class="primary" bindtap="approve" loading="{{submitting}}" disabled="{{submitting || busy || !quote}}">确认，制作整套 · {{quote ? quote.points : '读取费用中'}}积分</button></block>
    <view wx:if="{{project.completedCount > 3}}" class="completed-section"><view class="section-title">已完成 {{project.completedCount}} / 24 个动作</view><view class="completed-grid"><button wx:for="{{completed}}" wx:key="id" bindtap="preview" data-id="{{item.id}}"><image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFit"/><text>{{item.name}}</text></button></view></view><view wx:if="{{project.previewHash}}"><button wx:if="{{!shareToken}}" class="secondary" bindtap="prepareShare" loading="{{sharing}}">创建我的作品预览</button><block wx:else><button class="primary" open-type="share" data-sticker-work="true">发送作品给好友</button><button class="small-button" bindtap="revokeShare">关闭这次作品分享</button></block></view><button wx:if="{{project.ready}}" class="primary" bindtap="results">查看整套表情与导出选项 ↗</button><button wx:if="{{project.previewHash}}" class="secondary" open-type="share" data-sticker-template="true" data-sticker-mode="{{project.recipe.mode}}" data-sticker-style="{{project.recipe.styleId}}">分享模板，让好友做同款</button><button class="secondary project-progress" bindtap="progress">{{projectSessionUnavailable ? (showTaskRecords ? '收起任务记录' : '查看任务记录') : '查看会话任务'}}</button>
    <view wx:if="{{showTaskRecords}}" class="task-records"><view wx:for="{{projectJob.workflow}}" wx:for-item="step" wx:key="id" class="task-record"><view>{{step.stage || step.tool}} · {{step.status}}</view><text wx:if="{{step.detail}}" selectable>{{step.detail}}</text></view><view wx:if="{{!projectJob.workflow.length}}" class="muted">{{projectJob.error || '当前没有可用的处理记录。'}}</view></view>
    <button class="small-button edit-project" bindtap="regenerate" disabled="{{submitting || busy}}">调整设定，重新制作样张</button>
  </view>
  <view wx:if="{{projects.length}}" class="section-title">我的表情项目</view><button wx:for="{{projects}}" wx:key="id" class="project-row panel" bindtap="openProject" data-id="{{item.id}}"><text>{{item.recipe.name}}</text><text class="muted">{{item.recipe.mode === 'static' ? '静态' : '动态'}} · {{item.statusText}}　›</text></button>
  <view wx:if="{{selected}}" class="preview-mask" bindtap="closePreview"><image src="{{selected}}" mode="aspectFit"/></view>
  <privacy-dialog id="privacy"/>
</view>
