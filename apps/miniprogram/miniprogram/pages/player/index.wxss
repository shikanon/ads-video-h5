.player-title { font-size: 33rpx; font-weight: 650; line-height: 1.6; }.preview { margin: 30rpx 0; border-radius: 26rpx; overflow: hidden; background: #f7f0e8; }.preview video { width: 100%; height: 600rpx; background: #191714; }.preview image { width: 100%; display: block; }.audio-player { display: flex; flex-direction: column; align-items: center; gap: 25rpx; padding: 60rpx 25rpx; }.audio-mark { font-size: 80rpx; color: #cfa775; }.audio-player .secondary { width: 230rpx; }.save-button { margin-top: 25rpx; }.player-actions { margin-top: 25rpx; }.transcript { margin-top: 35rpx; line-height: 1.8; white-space: pre-wrap; }.transcript .section-title { margin-top: 0; }
