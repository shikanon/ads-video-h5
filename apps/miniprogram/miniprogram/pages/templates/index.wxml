<view class="screen template-gallery theme-surface theme-{{theme}}">
  <view wx:if="{{preview}}" class="template-detail">
    <button class="gallery-back" bindtap="closePreview">‹ 返回模板列表</button>
    <block wx:if="{{preview.sample}}">
      <video wx:if="{{!videoError}}" class="sample-player" src="{{preview.sample.video}}" poster="{{preview.sample.poster}}" controls="{{true}}" show-center-play-btn="{{true}}" object-fit="contain" binderror="playbackError" />
      <view wx:else class="sample-error"><text>样片暂时无法播放。</text><button class="secondary" bindtap="retryVideo">重新加载</button></view>
    </block>
    <view wx:else class="skill-banner"><image src="{{icons[preview.icon]}}" mode="aspectFit"/><text>{{preview.format}}</text></view>
    <view class="detail-copy">
      <text class="tag">{{preview.format}} · {{preview.seconds}} 秒{{preview.skill ? ' · 技能驱动' : ''}}</text>
      <view class="detail-title">{{preview.name}}</view>
      <view class="subtitle">{{preview.description}}</view>
      <view wx:if="{{preview.sample}}" class="muted">样片：{{preview.sample.title}} · 原作 {{preview.sample.author}}</view>
      <view class="detail-hint">{{preview.output === 'sticker-pack' ? '选用后预览24套表情、编辑故事短句，并选择是否同步生成分享视频。' : '选用后带入创作页，补充你的主题和素材，再发送开始制作。'}}</view>
    </view>
    <button class="primary sample-use" bindtap="use" data-id="{{preview.id}}" disabled="{{returning}}">使用这个模板 ↗</button>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </view>
  <block wx:else>
    <view class="gallery-eyebrow">轻喵创作工坊</view>
    <view class="gallery-heading">选一个起点，让灵感发生。</view>
    <view class="gallery-intro">模板与技能，帮你把想法做成作品。</view>
    <view wx:if="{{guest}}" class="empty"><image class="empty-icon" src="{{icons.idea}}" mode="aspectFit"/><text class="title">找到适合你的创作方式</text><view class="muted">登录后查看模板、技能和样片，选好再开始创作。</view><button class="secondary" bindtap="login">选择微信登录</button></view>
    <block wx:else>
      <input class="gallery-search" placeholder="搜索模板或技能" value="{{query}}" bindinput="input" maxlength="80" />
      <view class="gallery-filters">
        <button class="filter {{category === 'all' ? 'selected' : ''}}" bindtap="chooseFilter" data-category="all">全部</button>
        <button class="filter {{category === 'samples' ? 'selected' : ''}}" bindtap="chooseFilter" data-category="samples">有样片</button>
        <button class="filter {{category === 'skills' ? 'selected' : ''}}" bindtap="chooseFilter" data-category="skills">技能</button>
      </view>
      <view wx:if="{{error}}" class="gallery-error"><text>{{error}}</text><button class="small-button" bindtap="load">重新加载</button></view>
      <view wx:if="{{loading && !cards.length}}" class="empty muted">正在整理模板与技能…</view>
      <view wx:elif="{{!cards.length && !error}}" class="empty muted">没有找到匹配的模板或技能。</view>
      <view wx:else class="gallery-list">
        <view wx:for="{{cards}}" wx:key="id" class="gallery-card {{index === 0 ? 'featured' : ''}}">
          <button class="card-open {{item.sample ? 'sample-preview-button' : ''}}" bindtap="preview" data-id="{{item.id}}" aria-label="查看{{item.name}}">
            <view wx:if="{{item.sample}}" class="sample-cover"><image src="{{item.sample.poster}}" mode="aspectFill" lazy-load/><text class="sample-play">▶</text><text class="sample-time">{{item.seconds}} 秒</text></view>
            <view class="card-copy">
              <view class="card-heading"><view class="template-icon"><image src="{{icons[item.icon]}}" mode="aspectFit"/></view><text wx:if="{{item.skill}}" class="skill-label">技能</text></view>
              <view class="card-title">{{item.name}}</view><view class="card-description">{{item.description}}</view>
              <view class="card-meta"><text>{{item.format}} · {{item.seconds}} 秒</text><text class="card-arrow">↗</text></view>
            </view>
          </button>
          <button class="card-use" bindtap="use" data-id="{{item.id}}" disabled="{{returning}}">使用模板 ↗</button>
        </view>
      </view>
      <view wx:if="{{cards.length}}" class="gallery-footer">选用后可继续补充主题、风格和素材。</view>
    </block>
  </block>
  <privacy-dialog id="privacy" />
</view>
