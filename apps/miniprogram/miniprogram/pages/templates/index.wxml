<view class="workbench theme-surface theme-{{theme}}" style="height:{{height}}px">
  <view class="tw-rail">
    <button size="mini" class="tw-rail-item {{category==='stickers'?'tw-chosen':''}}" data-id="stickers" bindtap="category"><image class="tw-rail-glyph" src="{{icons.create}}" mode="aspectFit"/><text>表情</text></button>
    <button size="mini" class="tw-rail-item {{category==='video'?'tw-chosen':''}}" data-id="video" bindtap="category"><image class="tw-rail-glyph" src="{{icons.films}}" mode="aspectFit"/><text>视频</text></button>
    <button size="mini" class="tw-rail-item" data-id="note" bindtap="creative">笔记</button>
    <button size="mini" class="tw-rail-item" data-id="character" bindtap="creative">资产</button>
    <button size="mini" class="tw-rail-item" data-id="mv" bindtap="creative">MV</button>
    <button size="mini" class="tw-rail-bottom" data-id="projects" bindtap="openSheet" aria-label="项目"><image class="tw-control-icon" src="{{theme==='rich'?'/assets/ui/sidebar-light.png':'/assets/ui/sidebar-dark.png'}}" mode="aspectFit"/></button>
  </view>
  <view class="tw-desk">
    <view class="tw-heading"><button size="mini" class="tw-project-title" data-id="projects" bindtap="openSheet">{{projectName||(category==='stickers'?'表情画布':'视频画布')}}</button><button size="mini" class="tw-icon-button" bindtap="projectMenu" wx:if="{{sessionId}}" aria-label="管理当前项目">···</button><picker wx:if="{{category==='stickers'}}" class="tw-output" range="{{['静态','动态']}}" value="{{output==='dynamic'?1:0}}" bindchange="changeOutput"><view>{{output==='dynamic'?'动态':'静态'}}⌄</view></picker><button size="mini" class="tw-heading-action" data-id="projects" bindtap="openSheet">项目管理</button><button wx:if="{{category==='video'}}" size="mini" class="tw-batch-entry" bindtap="openBatch">批量制作</button></view>
    <view class="tw-quick-start"><button size="mini" data-id="templates" bindtap="openSheet">① 选模板</button><text>→</text><button size="mini" data-id="materials" bindtap="openSheet">② 加素材</button><text>→</text><text>③ 生成</text><view class="tw-grow"/><button size="mini" data-id="works" bindtap="openSheet">我的作品</button></view>
    <view class="tw-canvas-wrap" style="background-size:{{gridStep||15}}px {{gridStep||15}}px;background-position:{{gridX||0}}px {{gridY||0}}px" catchtouchstart="boardStart" catchtouchmove="boardMove" catchtouchend="boardEnd" catchtouchcancel="boardEnd">
      <view wx:for="{{nodes}}" wx:key="id" class="tw-canvas-node {{selectedId===item.id?'tw-selected':''}}" style="left:{{item.screenX}}px;top:{{item.screenY}}px;width:{{item.width}}px;height:{{item.height}}px;transform:scale({{item.screenScale}});z-index:{{item.layer}}" data-id="{{item.id}}" catchtouchstart="nodeStart" catchtouchmove="nodeMove" catchtouchend="nodeEnd" catchtouchcancel="nodeEnd" bindlongpress="nodeMenu">
        <image wx:if="{{item.cover}}" class="tw-node-image" src="{{item.cover}}" mode="aspectFit"/>
        <view wx:else class="tw-node-placeholder">{{item.kind==='document'?'文档':item.kind==='video'?'视频':'作品'}}</view>
        <view class="tw-node-corners" style="transform:scale({{1/item.screenScale}});transform-origin:top right" catchtouchstart="noop" catchtouchmove="noop" catchtouchend="noop"><button size="mini" data-id="{{item.id}}" catchtap="enlargeNode" aria-label="放大产物">＋</button><button size="mini" data-id="{{item.id}}" catchtap="removeNode" aria-label="移出画布">×</button></view>
        <view class="tw-node-caption"><text>{{item.label}}</text><button size="mini" data-id="{{item.id}}" catchtouchstart="noop" catchtouchend="noop" catchtap="previewNode" aria-label="查看产物">↗</button><button size="mini" data-id="{{item.id}}" catchtouchstart="noop" catchtouchend="noop" catchtap="nodeMenu" aria-label="产物菜单">···</button></view>
        <button size="mini" wx:if="{{item.candidate}}" class="tw-candidate {{item.locked?'tw-locked':''}}" data-id="{{item.id}}" catchtouchstart="noop" catchtouchend="noop" catchtap="chooseStyle" disabled="{{sending||job}}">{{item.locked?'已选画风':'选此画风'}}</button>
        <view wx:if="{{selectedId===item.id}}" class="tw-resize" style="transform:scale({{1/item.screenScale}});transform-origin:center" data-id="{{item.id}}" catchtouchstart="resizeStart" catchtouchmove="resizeMove" catchtouchend="resizeEnd" catchtouchcancel="resizeEnd">↘</view>
      </view>
      <view wx:if="{{!nodeCount}}" class="tw-canvas-empty"><text>＋</text><view>点空白处，放新作品</view><view class="tw-board-hint">拖动画布 · 双指缩放</view></view>
      <view wx:if="{{positionChosen}}" class="tw-position" style="left:{{targetX}}px;top:{{targetY}}px"><text>＋</text><view>新产物位置</view></view>
      <view wx:if="{{nodeCount}}" class="tw-board-hint tw-board-footer">拖动作品 · 双指缩放</view>
    </view>
    <view class="tw-toolbar"><button size="mini" class="tw-icon-button" data-delta="-0.1" bindtap="zoom" aria-label="缩小画布">−</button><text class="tw-zoom-value">{{zoomPercent}}%</text><button size="mini" class="tw-icon-button" data-delta="0.1" bindtap="zoom" aria-label="放大画布">＋</button><button size="mini" class="tw-icon-button" bindtap="fit" aria-label="适应画布"><view class="tw-fit-mark"/></button><button size="mini" class="tw-undo" bindtap="undo" wx:if="{{undoNode}}">撤销</button><view class="tw-grow"/><button size="mini" class="tw-icon-button" data-id="materials" bindtap="openSheet" aria-label="添加素材">＋</button><button size="mini" class="tw-icon-button" bindtap="chat" disabled="{{!sessionId}}" aria-label="查看对话"><image class="tw-control-icon" src="{{icons.newChat}}" mode="aspectFit"/></button></view>
    <view wx:if="{{error}}" class="tw-issue"><text selectable>{{error}}</text><button size="mini" bindtap="load" disabled="{{loading}}">刷新</button></view>
    <view wx:if="{{job}}" class="tw-stage"><text>{{job.stage}}</text><button size="mini" bindtap="stop">停止</button></view>
    <view wx:elif="{{project}}" class="tw-stage">
      <button size="mini" wx:if="{{project.ready}}" bindtap="results">查看整套 ↗</button>
      <button size="mini" wx:elif="{{lastJob.failed}}" bindtap="retry" disabled="{{sending}}">续做 · {{quote.points||0}}积分</button>
      <button size="mini" wx:elif="{{project.previewHash}}" bindtap="approve" disabled="{{sending||!quote}}">确认整套 · {{quote.points||0}}积分</button>
      <text wx:elif="{{project.styleCandidates.length}}">选画风 · 样张{{quote.points||0}}积分</text>
    </view>
    <view wx:if="{{templateId==='qingmao-stickers' && !project && !job}}" class="tw-stage"><text>2种画风 · {{stylePrice}}积分</text></view>
    <scroll-view wx:if="{{attached.length}}" class="tw-attachments" scroll-x><view class="tw-attachment" wx:for="{{attached}}" wx:key="id"><text>{{item.name}}</text><button size="mini" data-id="{{item.id}}" bindtap="removeAttachment">×</button></view></scroll-view>
    <view class="tw-compose"><view class="tw-context">{{selectedLabel||templateName||'制作要求'}}</view><view class="tw-input-row"><button size="mini" class="tw-add" data-id="materials" bindtap="openSheet" aria-label="添加附件">＋</button><textarea class="tw-draft" value="{{prompt}}" bindinput="input" placeholder="输入要求…" maxlength="20000" auto-height adjust-position="{{false}}" bindkeyboardheightchange="keyboard"/><button size="mini" class="tw-send" bindtap="send" loading="{{sending}}" disabled="{{sending||uploading}}" aria-label="生成">生成</button></view></view>
    <view wx:if="{{!keyboardVisible}}" class="tw-shelf">
      <view class="tw-shelf-bar"><text>模板</text><scroll-view wx:if="{{category==='video'}}" class="tw-filters" scroll-x><button size="mini" class="{{filter==='all'?'tw-chosen':''}}" data-id="all" bindtap="chooseFilter">全部</button><block wx:if="{{category==='video'}}"><button size="mini" data-id="interface" bindtap="chooseFilter" class="{{filter==='interface'?'tw-chosen':''}}">界面</button><button size="mini" data-id="diagram" bindtap="chooseFilter" class="{{filter==='diagram'?'tw-chosen':''}}">图解</button><button size="mini" data-id="product" bindtap="chooseFilter" class="{{filter==='product'?'tw-chosen':''}}">产品</button><button size="mini" data-id="editing" bindtap="chooseFilter" class="{{filter==='editing'?'tw-chosen':''}}">剪辑</button></block></scroll-view><view wx:if="{{category!=='video'}}" class="tw-grow"/><button size="mini" class="tw-expand" data-id="templates" bindtap="openSheet">展开</button><button size="mini" class="tw-icon-button" bindtap="shelf" aria-label="折叠模板"><view class="tw-chevron {{shelf?'':'tw-chevron-up'}}"/></button></view>
      <scroll-view wx:if="{{shelf}}" class="tw-template-strip" scroll-x><view class="tw-template" wx:for="{{cards}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseTemplate"><image wx:if="{{item.thumbnail}}" class="tw-template-icon {{templateId===item.id?'tw-selected':''}}" mode="{{item.sticker?'aspectFit':'aspectFill'}}" src="{{item.thumbnail}}"/><view wx:else class="tw-template-icon tw-template-glyph">✧</view><text>{{item.name}}</text></view></scroll-view>
    </view>
  </view>
  <view wx:if="{{sheet}}" class="tw-sheet-mask" bindtap="closeSheet"><view class="tw-sheet" catchtap="noop"><view class="tw-sheet-heading"><text>{{sheet==='materials'?'素材':sheet==='projects'?'项目管理':sheet==='templates'?'模板':sheet==='works'?'我的作品':sheet==='batch'?'批量制作':sheet==='batchDetail'?'批量项目':'设置'}}</text><button size="mini" bindtap="closeSheet">×</button></view>
    <view wx:if="{{error}}" class="tw-sheet-error">{{error}}</view>
    <block wx:if="{{sheet==='materials'}}"><view class="tw-sheet-actions"><button size="mini" bindtap="upload" loading="{{uploading}}">上传图片 / 视频</button><button size="mini" bindtap="upload" data-kind="document">聊天文件 / 文档</button></view><scroll-view scroll-y class="tw-sheet-list"><view class="tw-material-row" wx:for="{{materials}}" wx:key="id"><image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill"/><button size="mini" class="tw-grow" data-id="{{item.id}}" bindtap="attach">{{item.name}}</button><button size="mini" data-id="{{item.id}}" bindtap="deleteMaterial">删除</button></view><view wx:if="{{!materials.length}}" class="quiet">暂无素材</view></scroll-view></block>
    <block wx:elif="{{sheet==='projects'}}"><view class="tw-sheet-actions"><button size="mini" class="tw-sheet-primary" bindtap="newProject">＋ 新画布</button><button size="mini" class="tw-sheet-primary" bindtap="openBatch">批量视频</button></view><scroll-view scroll-y class="tw-sheet-list"><view class="tw-list-label" wx:if="{{batches.length}}">批量项目</view><button size="mini" class="tw-batch-row" wx:for="{{batches}}" wx:key="id" data-id="{{item.id}}" bindtap="openBatchDetail"><view class="tw-row-title">{{item.name}}<text>›</text></view><view class="tw-row-meta">{{item.templateName}} · {{item.done}}/{{item.count}}完成<text wx:if="{{item.active}}"> · 制作中</text><text wx:if="{{item.failed}}"> · 未完成 {{item.failed}}</text></view><view class="tw-progress"><view style="width:{{item.count?item.done/item.count*100:0}}%"/></view></button><view class="tw-list-label" wx:if="{{projects.length}}">单项项目</view><view class="tw-project-row" wx:for="{{projects}}" wx:key="id"><button size="mini" class="tw-grow" data-id="{{item.id}}" bindtap="openProject">{{item.name}}<view class="tw-row-meta">{{item.category==='stickers'?'表情':'视频'}} · {{item.count}}件作品</view></button><button size="mini" data-id="{{item.id}}" bindtap="projectMenu">···</button></view><view wx:if="{{!projects.length&&!batches.length}}" class="quiet">从新画布或批量视频开始</view></scroll-view></block>
    <block wx:elif="{{sheet==='templates'}}"><input class="tw-search" placeholder="搜索模板" value="{{templateQuery}}" bindinput="templateSearch"/><scroll-view scroll-y class="tw-sheet-list"><view class="tw-template-grid"><view class="tw-template" wx:for="{{templateResults}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseTemplate"><image wx:if="{{item.thumbnail}}" class="tw-template-icon" src="{{item.thumbnail}}" mode="{{item.sticker?'aspectFit':'aspectFill'}}"/><view wx:else class="tw-template-icon tw-template-glyph">✧</view><text>{{item.name}}</text></view></view><view wx:if="{{!templateResults.length}}" class="quiet">未找到模板</view></scroll-view></block>
    <block wx:elif="{{sheet==='works'}}"><scroll-view scroll-y class="tw-sheet-list"><view class="tw-work-row" wx:for="{{works}}" wx:key="id"><image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFit"/><view class="tw-work-placeholder" wx:else>{{item.kind==='video'?'视频':'作品'}}</view><view class="tw-grow"><view class="tw-row-title">{{item.label}}</view><view class="tw-work-actions"><button size="mini" data-id="{{item.id}}" bindtap="openWork">打开</button><button size="mini" wx:if="{{item.sourceKind==='artifact'}}" data-id="{{item.id}}" bindtap="learnWork">提炼模板</button><button size="mini" data-id="{{item.id}}" bindtap="placeWork">放到当前位置</button></view></view></view><button size="mini" wx:if="{{moreWorks}}" bindtap="moreWorks" class="tw-load-more">加载更多</button><view wx:if="{{!works.length}}" class="quiet">暂无作品</view></scroll-view></block>
    <block wx:elif="{{sheet==='batch'}}"><view class="tw-batch-form"><picker range="{{batchTemplates}}" value="{{batchTemplateIndex}}" bindchange="batchTemplate"><view class="tw-form-picker">模板 <text>{{batchTemplates[batchTemplateIndex]||'暂无可用模板'}} ⌄</text></view></picker><input placeholder="项目名称（选填）" maxlength="60" value="{{batchName}}" data-field="batchName" bindinput="batchField"/><textarea class="tw-batch-topics" placeholder="每行一个视频主题，最多20行" maxlength="40000" value="{{batchText}}" data-field="batchText" bindinput="batchField"/><view class="tw-row-meta">{{batchCount}}/20 个视频 · 共用 {{attachmentIds.length}} 个素材</view><view class="tw-sheet-actions"><button size="mini" data-id="materials" bindtap="openSheet">添加素材</button></view><view class="tw-row-meta">按实际用量扣积分，支持停止和续做</view><button size="mini" class="tw-confirm" loading="{{batchSending}}" disabled="{{batchSending||!batchCount||batchCount>20||!batchTemplateId}}" bindtap="startBatch">开始制作 {{batchCount}} 个视频</button></view></block>
    <block wx:elif="{{sheet==='batchDetail'}}"><block wx:if="{{batchDetail}}"><view class="tw-row-title">{{batchDetail.name}}</view><view class="tw-row-meta">{{batchDetail.done}}/{{batchDetail.count}} 完成 · {{batchDetail.templateName}}</view><view class="tw-sheet-actions tw-batch-actions"><button size="mini" bindtap="batchCanvas">查看画布</button><button size="mini" wx:if="{{batchDetail.active}}" data-action="stop" bindtap="batchAction" disabled="{{batchSending}}">停止</button><button size="mini" wx:else data-action="resume" bindtap="batchAction" disabled="{{batchSending}}">继续未完成</button><button size="mini" data-action="rename" bindtap="batchAction" disabled="{{batchSending}}">改名</button><button size="mini" data-action="delete" bindtap="batchAction" disabled="{{batchSending||batchDetail.active}}">删除</button></view><scroll-view scroll-y class="tw-sheet-list"><button size="mini" class="tw-batch-item" wx:for="{{batchDetail.items}}" wx:key="index" data-index="{{item.index}}" bindtap="batchItem" disabled="{{!item.sessionId||item.unavailable}}"><text>{{item.index+1}}. {{item.topic}}</text><text class="tw-status">{{item.statusLabel}} ›</text><view wx:if="{{item.error}}" class="tw-row-meta">{{item.error}}</view></button></scroll-view></block><view wx:else class="quiet">项目已删除</view></block>
    <view wx:else class="tw-settings"><button size="mini" bindtap="showAll" disabled="{{!sessionId}}">显示全部画布内容</button><button size="mini" bindtap="chat" disabled="{{!sessionId}}">查看对话 ↗</button><button size="mini" data-id="projects" bindtap="openSheet">项目管理 ↗</button></view>
  </view></view>
</view>
