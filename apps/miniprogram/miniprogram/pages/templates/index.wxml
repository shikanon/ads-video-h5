<view class="screen template-gallery theme-surface theme-{{theme}}">
  <view wx:if="{{preview}}" class="template-detail">
    <button class="gallery-back" bindtap="closePreview">‹ 返回工具列表</button>
    <view class="skill-banner"><image src="{{icons[preview.icon]}}" mode="aspectFit"/><text>{{preview.format}}</text></view>
    <view class="detail-copy"><view class="detail-title">{{preview.name}}</view><view class="subtitle">{{preview.description}}</view>
      <view class="field-label">你需要提供</view><view class="muted">{{preview.input}}</view>
      <view class="field-label">制作步骤</view><view wx:for="{{preview.steps}}" wx:key="index" class="muted">{{index + 1}}. {{item}}</view>
      <view class="field-label">制作结果</view><view class="muted">{{preview.result}}</view>
    </view>
    <button class="primary" bindtap="use" data-id="{{preview.id}}" disabled="{{returning}}">使用工具 ↗</button><view wx:if="{{error}}" class="error">{{error}}</view>
  </view>
  <block wx:else>
    <view wx:if="{{guest}}" class="empty"><text class="title">选择创作工具</text><view class="muted">登录后提供主题或自己的素材，开始制作。</view><button class="secondary" bindtap="login">选择微信登录</button></view>
    <block wx:else>
      <input class="gallery-search" placeholder="搜索工具或技能" value="{{query}}" bindinput="input" maxlength="80"/>
      <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}"><view class="gallery-filters"><button wx:for="{{categories}}" wx:key="id" class="filter {{category === item.id ? 'selected' : ''}}" bindtap="chooseFilter" data-category="{{item.id}}">{{item.name}}</button></view></scroll-view>
      <view class="section-heading"><text>创作工具</text><text class="section-note">{{cards.length}} 个</text></view>
      <view wx:if="{{error}}" class="gallery-error"><text>{{error}}</text><button class="small-button" bindtap="load">重新加载</button></view>
      <view wx:if="{{loading && !cards.length}}" class="empty muted">正在读取工具…</view><view wx:elif="{{!cards.length && !error}}" class="empty muted">没有找到匹配的工具。</view>
      <view wx:else class="gallery-list"><view wx:for="{{cards}}" wx:key="id" class="gallery-card">
        <button class="card-open" bindtap="preview" data-id="{{item.id}}"><view class="tool-cover cover-{{item.category}}"><view class="designed-cover"><image src="{{icons[item.icon]}}" mode="aspectFit"/><text class="cover-title">{{item.coverTitle}}</text><text class="cover-note">{{item.coverNote}}</text></view></view><view class="card-copy"><view class="card-title">{{item.name}}</view><view class="card-description">{{item.description}}</view></view></button>
        <button class="card-use" bindtap="use" data-id="{{item.id}}" disabled="{{returning}}">使用工具 ↗</button>
      </view></view>
    </block>
  </block><privacy-dialog id="privacy"/>
</view>
