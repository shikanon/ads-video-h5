/* This page deliberately does not reuse chat's composer/filters classes. */
.workbench.theme-surface{min-height:0;--tw-bg:#fff9ee;--tw-paper:#fffdf8;--tw-ink:#69473c;--tw-muted:#947052;--tw-line:#e6d7bd;--tw-soft:#f4e3c6;--tw-accent:#c9612f;background:var(--tw-bg);font-size:13px;line-height:1.5}
.workbench.theme-rich{--tw-bg:#241d18;--tw-paper:#302720;--tw-ink:#f5e8d9;--tw-muted:#c5ad95;--tw-line:#5b4636;--tw-soft:#483426}
.workbench button{box-sizing:border-box;min-width:0;max-width:100%;margin:0;padding:0;border:0;background:transparent;font-size:inherit;font-weight:400;line-height:1.5}
.workbench button[disabled]{background:transparent;opacity:.45}
.workbench .tw-rail{width:51px;flex:0 0 51px;align-items:center;gap:8px;padding:11px 3px 10px}
.workbench .tw-rail-item{width:43px;flex:0 0 auto;min-height:57px;gap:5px;padding:7px 0;font-size:11px;border-radius:12px;justify-content:center;color:var(--tw-muted)}
.workbench .tw-rail-item.tw-chosen{background:var(--tw-soft);color:var(--tw-accent)}
.workbench .tw-rail-glyph{width:21px;height:21px}
.workbench .tw-rail-bottom{width:43px;height:40px;min-height:0;display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.workbench .tw-desk{min-height:0}
.workbench .tw-heading{height:46px;min-height:46px;flex:0 0 46px;padding:7px 9px;gap:2px;border-bottom-color:var(--tw-line)}
.workbench .tw-project-title{width:0;flex:1 1 0;min-width:0;padding:4px 0;font-size:14px}
.workbench .tw-output{flex:0 0 auto;max-width:67px;font-size:12px;padding:4px 5px}
.workbench .tw-icon-button{width:32px;height:32px;min-width:32px;flex:0 0 32px;display:inline-flex;align-items:center;justify-content:center;font-size:18px;border-radius:8px;color:var(--tw-muted)}
.workbench .tw-control-icon{width:18px;height:18px;flex:0 0 18px;display:block}
.workbench .tw-canvas-wrap{min-height:120px;background-color:#f4efe5;background-image:radial-gradient(var(--tw-line) .8px,transparent .8px);background-size:15px 15px}
.workbench.theme-rich .tw-canvas-wrap{background-color:#1d1915}
.workbench .tw-canvas-empty{top:0;left:0;width:100%;height:100%;display:flex;justify-content:center;align-items:center;gap:12px;font-size:13px;color:var(--tw-muted);border-radius:0}
.workbench .tw-canvas-empty text{font-size:29px;line-height:1}
.workbench .tw-toolbar{height:35px;min-height:35px;flex:0 0 35px;padding:0 6px;font-size:11px;gap:0;background:var(--tw-bg)}
.workbench .tw-toolbar .tw-icon-button{width:27px;min-width:27px;flex-basis:27px;height:29px;padding:0}
.workbench .tw-zoom-value{font-size:11px;color:var(--tw-muted);min-width:32px;text-align:center}
.workbench .tw-undo{font-size:11px;color:var(--tw-accent);padding:4px}
.workbench .tw-grow{flex:1;min-width:0}
.workbench .tw-fit-mark{position:relative;width:14px;height:14px;border:1px solid var(--tw-muted);border-radius:2px}
.workbench .tw-fit-mark::before{content:'';position:absolute;inset:3px -2px;background:var(--tw-bg)}
.workbench .tw-fit-mark::after{content:'';position:absolute;inset:-2px 3px;background:var(--tw-bg)}
.workbench .tw-compose{flex:0 0 auto;padding:6px 9px;background:var(--tw-bg)}
.workbench .tw-context{font-size:11px;color:var(--tw-muted);height:20px;line-height:20px;margin-bottom:5px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.workbench .tw-input-row{display:flex;align-items:center;gap:3px;padding:5px;border:1px solid var(--tw-line);border-radius:12px;background:var(--tw-paper);min-height:50px}
.workbench .tw-add{flex:0 0 32px;width:32px;height:32px;display:flex;align-items:center;justify-content:center;font-size:22px;color:var(--tw-muted)}
.workbench .tw-draft{flex:1 1 0%;width:0;min-width:0;min-height:38px;height:38px;max-height:100px;display:block;padding:7px 1px;font-size:13px;line-height:1.6;color:var(--tw-ink);background:transparent}
.workbench .tw-send{flex:0 0 32px;width:32px;min-width:32px;max-width:32px;height:32px;line-height:32px;display:flex;align-items:center;justify-content:center;background:var(--tw-accent);color:#fff9ee;border-radius:9px;font-size:22px}
.workbench .tw-send[disabled]{background:var(--tw-accent);color:#fff9ee}
.workbench .tw-shelf{padding:4px 9px 8px;border-top:1px solid var(--tw-line);background:var(--tw-bg)}
.workbench .tw-shelf-bar{height:29px;min-height:29px;display:flex;padding:0;gap:5px;font-size:12px}
.workbench .tw-filters{display:block;white-space:nowrap;flex:1 1 0%;min-width:0;width:0;height:29px;margin:0;padding:0}
.workbench .tw-filters button{display:inline-block;width:auto;max-width:none;height:29px;line-height:29px;margin:0;padding:0 9px;border:0;border-radius:7px;font-size:11px;vertical-align:top;color:var(--tw-muted)}
.workbench .tw-filters button.tw-chosen{background:var(--tw-soft);color:var(--tw-accent)}
.workbench .tw-expand{font-size:11px;min-height:29px;padding:2px 7px;color:var(--tw-muted);flex:0 0 auto}
.workbench .tw-template-strip{padding:2px 1px 5px;white-space:nowrap;width:100%;height:88px}
.workbench .tw-template{display:inline-flex;width:70px;min-width:70px;vertical-align:top;flex-direction:column;align-items:center;gap:4px;padding:3px 0;margin-right:9px;background:transparent}
.workbench .tw-template-icon{width:56px;height:56px;border-radius:10px;background:var(--tw-paper);border:0;flex:0 0 56px}
.workbench .tw-template-icon.tw-selected{outline:1.5px solid var(--tw-accent);outline-offset:2px;border:0}
.workbench .tw-template text{font-size:11px;width:70px;padding:2px 0 0;line-height:16px}
.workbench .tw-template-grid{gap:15px 0}
.workbench .tw-template-grid .tw-template{width:25%;min-width:0;margin-right:0}
@media(max-width:360px){.workbench .tw-rail{width:45px;flex-basis:45px;padding-left:0;padding-right:0}.workbench .tw-rail-item{width:39px}.workbench .tw-template-grid .tw-template{width:33.3333%}}

.workbench .tw-rail-item{display:flex;flex-direction:column;align-items:center}
.workbench .tw-rail-item text{font-size:11px;line-height:16px}
.workbench .tw-rail-bottom{margin-top:auto}
.workbench .tw-shelf-bar{display:flex;align-items:center;flex-wrap:nowrap;justify-content:space-between}
.workbench .tw-shelf-bar .tw-icon-button{height:29px;flex:0 0 27px;width:27px;min-width:27px}
.workbench .tw-sheet-actions button,.workbench .tw-sheet-primary{background:var(--tw-soft);color:var(--tw-accent);font-size:13px;padding:9px}
.workbench .tw-material-row button,.workbench .tw-project-row button{padding:9px 0;font-size:12px;text-align:left}
.workbench .tw-settings button,.workbench .tw-settings picker{display:block;padding:12px 0;font-size:13px;text-align:left}
.workbench .tw-candidate{position:absolute;bottom:38px;left:8px;right:8px;font-size:12px;background:var(--tw-soft);color:var(--tw-accent);border-radius:8px;padding:4px}
.workbench .tw-candidate.tw-locked{background:var(--tw-accent);color:#fff9ee}

.workbench scroll-view{box-sizing:border-box}
.workbench .tw-expand{display:flex;align-items:center;justify-content:center;padding:0 7px}
.workbench .tw-chevron{display:flex;align-items:center;justify-content:center;width:14px;height:14px}
.workbench .tw-chevron::after{content:'';display:block;width:7px;height:7px;border-right:1px solid var(--tw-muted);border-bottom:1px solid var(--tw-muted);transform:rotate(45deg) translate(-1px,-1px)}
.workbench .tw-chevron-up{transform:rotate(180deg)}
/* Virtual world: render visible nodes; pan without scroll boundaries. */
.workbench .tw-heading{gap:5px;padding:6px 8px}
.workbench .tw-heading-action{font-size:11px;padding:6px 3px;flex-shrink:0;color:var(--tw-accent)}
.workbench .tw-batch-entry{font-size:11px;padding:7px 8px;border-radius:9px;background:var(--tw-accent);color:#fff;flex-shrink:0}
.workbench .tw-quick-start{display:flex;align-items:center;gap:5px;flex:0 0 29px;padding:0 9px;font-size:10px;color:var(--tw-muted);border-bottom:1px solid var(--tw-line)}
.workbench .tw-quick-start button{font-size:10px;color:var(--tw-accent);padding:4px 0}
.workbench .tw-canvas-node{position:absolute;transform-origin:0 0;box-sizing:border-box;overflow:visible;border:1px solid var(--tw-line);border-radius:9px;box-shadow:0 2px 8px #0001}
.workbench .tw-canvas-node.tw-selected{outline:2px solid var(--tw-accent);outline-offset:1px}
.workbench .tw-node-image,.workbench .tw-node-placeholder{height:calc(100% - 30px);border-radius:8px 8px 0 0;overflow:hidden}
.workbench .tw-node-caption{height:30px;padding-left:6px;font-size:11px;background:var(--tw-paper);border-radius:0 0 8px 8px}
.workbench .tw-node-caption button{width:26px;height:28px;flex-shrink:0;color:var(--tw-accent)}
.workbench .tw-node-corners{position:absolute;right:4px;top:4px;display:flex;gap:3px}
.workbench .tw-node-corners button{width:24px;height:24px;line-height:22px;border-radius:7px;border:1px solid var(--tw-line);background:var(--tw-paper);color:var(--tw-accent);font-size:17px;box-shadow:0 1px 3px #0002}
.workbench .tw-resize{position:absolute;right:-7px;bottom:-7px;width:22px;height:22px;text-align:center;border-radius:6px;background:var(--tw-accent);color:#fff;font-size:15px;z-index:3}
.workbench .tw-candidate{bottom:34px;left:4px;right:4px;font-size:10px;padding:3px;background:var(--tw-soft)}
.workbench .tw-candidate.tw-locked{background:var(--tw-accent);color:#fff}
.workbench .tw-canvas-empty{pointer-events:none;gap:10px}
.workbench .tw-board-hint{font-size:10px;color:var(--tw-muted);pointer-events:none}
.workbench .tw-board-footer{position:absolute;bottom:7px;left:8px;z-index:1000000002;background:var(--tw-paper);padding:2px 5px;border-radius:5px}
.workbench .tw-position{position:absolute;pointer-events:none;color:var(--tw-accent);z-index:1000000002;transform:translate(-10px,-18px);white-space:nowrap}
.workbench .tw-position text{font-size:26px;line-height:30px}
.workbench .tw-position view{font-size:10px;background:var(--tw-paper);padding:2px 4px;border-radius:4px}
.workbench .tw-send{flex:0 0 46px;width:46px;min-width:46px;max-width:46px;font-size:12px}
.workbench .tw-sheet{box-sizing:border-box}
.workbench .tw-sheet-error{color:#b2462b;font-size:12px;margin:4px 0 12px}
.workbench .tw-list-label{font-size:11px;color:var(--tw-muted);padding:12px 0 4px}
.workbench .tw-batch-row{display:block;width:100%;text-align:left;padding:12px;border:1px solid var(--tw-line);border-radius:10px;margin-bottom:8px;background:var(--tw-bg)}
.workbench .tw-row-title{font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.workbench .tw-row-title>text{float:right}
.workbench .tw-row-meta{font-size:11px;color:var(--tw-muted);line-height:1.6;white-space:normal}
.workbench .tw-progress{height:4px;background:var(--tw-soft);border-radius:4px;margin-top:8px;overflow:hidden}
.workbench .tw-progress>view{height:100%;background:var(--tw-accent)}
.workbench .tw-search,.workbench .tw-batch-form input{border:1px solid var(--tw-line);background:var(--tw-bg);border-radius:8px;padding:9px 10px;height:40px;box-sizing:border-box;font-size:13px;margin-bottom:10px}
.workbench .tw-work-row{display:flex;gap:12px;padding:10px 0;border-bottom:1px solid var(--tw-line);align-items:center}
.workbench .tw-work-row image,.workbench .tw-work-placeholder{width:58px;height:64px;flex:0 0 58px;border-radius:7px;background:var(--tw-soft)}
.workbench .tw-work-placeholder{display:flex;align-items:center;justify-content:center;font-size:11px}
.workbench .tw-work-actions{display:flex;gap:16px;margin-top:9px}
.workbench .tw-work-actions button{font-size:11px;color:var(--tw-accent);padding:4px 0}
.workbench .tw-load-more{width:100%;font-size:12px;padding:15px;color:var(--tw-accent)}
.workbench .tw-form-picker{padding:10px 0;margin-bottom:8px;border-bottom:1px solid var(--tw-line);font-size:12px}
.workbench .tw-form-picker text{float:right;color:var(--tw-accent)}
.workbench .tw-batch-topics{width:100%;box-sizing:border-box;height:150px;padding:12px;border:1px solid var(--tw-line);border-radius:10px;background:var(--tw-bg);font-size:13px;line-height:1.7;margin-bottom:8px}
.workbench .tw-confirm{margin-top:12px;width:100%;padding:12px;background:var(--tw-accent);color:#fff;border-radius:10px;font-size:13px}
.workbench .tw-batch-actions{margin-top:12px;flex-wrap:wrap}
.workbench .tw-batch-actions button{font-size:11px;padding:7px 10px;border-radius:7px}
.workbench .tw-batch-item{display:block;width:100%;padding:14px 0;border-bottom:1px solid var(--tw-line);text-align:left;font-size:12px}
.workbench .tw-batch-item>text:first-child{display:inline-block;max-width:70%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.workbench .tw-status{float:right;color:var(--tw-accent);font-size:11px}

.workbench .tw-confirm[disabled]{background:var(--tw-soft);color:var(--tw-muted)}
