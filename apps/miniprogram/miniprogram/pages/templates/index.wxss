.gallery-search { height:78rpx; padding:0 24rpx; border:1rpx solid var(--lm-line); background:var(--lm-paper); border-radius:24rpx; font-size:25rpx; }
.gallery-filters { display:flex; margin:22rpx 0 28rpx; }
.gallery-filters .filter { flex:0 0 auto; width:auto; margin:0 14rpx 0 0; padding:12rpx 25rpx; font-size:24rpx; color:var(--lm-muted); border-radius:30rpx; }
.gallery-filters .selected { color:var(--lm-accent); background:var(--lm-soft); }
.gallery-list { display:flex; flex-wrap:wrap; align-items:stretch; justify-content:space-between; }
.gallery-card { box-sizing:border-box; width:48.5%; flex:0 0 48.5%; min-width:0; display:flex; flex-direction:column; margin-bottom:22rpx; border:1rpx solid var(--lm-line); border-radius:28rpx; background:var(--lm-soft); overflow:hidden; }
.gallery-card.featured { width:100%; flex-basis:100%; }
.theme-surface .card-open { display:block; flex:1; width:100%; max-width:none; margin:0; padding:0; text-align:left; color:var(--lm-ink); white-space:normal; border-radius:0; background:transparent; line-height:1.6; }
.card-copy { padding:22rpx; }
.card-heading { display:flex; justify-content:space-between; align-items:center; margin-bottom:18rpx; }
.template-icon { width:60rpx; height:60rpx; border-radius:20rpx; display:flex; align-items:center; justify-content:center; background:var(--lm-paper); }
.template-icon image { width:40rpx; height:40rpx; }
.skill-label { color:var(--lm-muted); font-size:19rpx; padding:2rpx 11rpx; border:1rpx solid var(--lm-line); border-radius:14rpx; }
.card-title { font-size:28rpx; line-height:1.5; margin-bottom:8rpx; overflow-wrap:break-word; }
.card-description { font-size:23rpx; color:var(--lm-muted); line-height:1.7; display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }
.card-meta { display:flex; align-items:center; justify-content:space-between; margin-top:20rpx; font-size:20rpx; color:var(--lm-muted); }
.card-arrow { color:var(--lm-accent); font-size:28rpx; }
.theme-surface .card-use { width:100%; max-width:none; margin:0; padding:17rpx 22rpx; text-align:left; border-top:1rpx solid var(--lm-line); border-radius:0; background:transparent; color:var(--lm-accent); font-size:23rpx; }
.gallery-back { width:auto; margin:0 0 22rpx; padding:8rpx 0; text-align:left; color:var(--lm-accent); font-size:25rpx; }
.skill-banner { height:240rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; background:var(--lm-soft); border:1rpx solid var(--lm-line); border-radius:28rpx; color:var(--lm-muted); font-size:24rpx; }
.skill-banner image { width:90rpx; height:90rpx; margin-bottom:20rpx; }
.detail-copy { padding:28rpx 0; }
.detail-title { font-size:38rpx; margin:18rpx 0 12rpx; }
.detail-copy .muted { font-size:23rpx; margin-top:18rpx; }
.detail-hint,.gallery-footer { color:var(--lm-muted); font-size:23rpx; line-height:1.8; margin-top:24rpx; }
.gallery-footer { text-align:center; margin:8rpx 0 24rpx; }
.gallery-error { color:var(--lm-error,#b55841); font-size:24rpx; padding:16rpx 0; }
.gallery-error button { display:inline-block; margin-left:12rpx; }
.empty .secondary { width:auto; margin:28rpx auto 0; }
@media (max-width:350px) { .gallery-heading { font-size:34rpx; }.card-copy { padding:18rpx; }.card-title { font-size:26rpx; } }

.category-scroll { width:100%; white-space:nowrap; margin:18rpx 0 30rpx; }
.gallery-filters { display:inline-flex; margin:0; }
.gallery-filters .filter { padding:14rpx 22rpx; margin-right:8rpx; font-size:26rpx; }
.gallery-filters .selected { font-weight:600; }
.section-heading { display:flex; justify-content:space-between; align-items:center; font-size:29rpx; font-weight:600; margin:0 0 22rpx; }
.section-note { font-size:21rpx; font-weight:400; color:var(--lm-muted); }
.catalog-heading { margin-top:38rpx; }
.gallery-card { background:var(--lm-paper); border:0; border-radius:22rpx; margin-bottom:26rpx; }
.cover-badge { position:absolute; left:14rpx; top:14rpx; color:var(--lm-ink); background:var(--lm-paper); padding:6rpx 12rpx; border-radius:12rpx; font-size:19rpx; line-height:1.5; }
.card-copy { padding:18rpx 12rpx 12rpx; }
.card-title { font-size:28rpx; font-weight:600; }
.card-description { -webkit-line-clamp:2; font-size:22rpx; line-height:1.6; min-height:70rpx; }
.card-meta { margin-top:14rpx; }
.theme-surface .card-use { padding:14rpx 12rpx; font-size:22rpx; }
.designed-cover { box-sizing:border-box; position:relative; height:100%; padding:28rpx 20rpx 20rpx; background:linear-gradient(145deg,var(--lm-soft),var(--lm-paper)); display:flex; flex-direction:column; }
.cover-game .designed-cover { background:linear-gradient(145deg,#e4e8da,#f6e8cc); }
.cover-news .designed-cover { background:linear-gradient(145deg,#ecd9c4,#f9efdf); }
.cover-knowledge .designed-cover { background:linear-gradient(145deg,#dce8e0,#f4eddb); }
.cover-product .designed-cover { background:linear-gradient(145deg,#dfddef,#f6ecdf); }
.designed-cover image { width:44rpx; height:44rpx; margin-bottom:14rpx; flex:none; }
.cover-title { font-size:30rpx; font-weight:600; line-height:1.5; white-space:pre-line; color:#69473c; }
.cover-note { margin-top:12rpx; font-size:19rpx; color:#856d5c; }
.cover-brand { position:absolute; bottom:18rpx; left:24rpx; font-size:12rpx; letter-spacing:1rpx; color:#856d5c; }
.category-scroll { height:76rpx; }

.tool-cover{position:relative;height:280rpx;background:var(--lm-soft);border-radius:22rpx;overflow:hidden}
