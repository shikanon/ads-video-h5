.auth-screen {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0 36rpx calc(56rpx + env(safe-area-inset-bottom));
  text-align: center;
}
.auth-content { padding-top: clamp(64rpx, 8.5vh, 122rpx); }
.auth-logo { display: block; width: 114rpx; height: 114rpx; margin: 0 auto 32rpx; }
.theme-surface .auth-title { font-size: 54rpx; }
.auth-description { margin-top: 16rpx; }
.theme-surface .auth-content .wechat-login { margin-top: 56rpx; }
.theme-surface .auth-content .auth-browse {
  display: block;
  min-height: 76rpx;
  margin: 16rpx auto 0;
  padding: 12rpx 20rpx;
  color: var(--lm-ink);
  font-size: 28rpx;
  font-weight: 600;
}
.auth-rewards { margin-top: 18rpx; }
.auth-points { color: var(--lm-ink); font-weight: 600; }
.auth-footer { margin-top: auto; padding-top: 72rpx; }
.auth-legal { display: flex; align-items: center; justify-content: center; gap: 16rpx; margin-top: 10rpx; }
.theme-surface .auth-legal-link { min-height: 68rpx; padding: 12rpx 16rpx; color: var(--lm-ink); font-size: 25rpx; }
.auth-legal-divider { width: 1rpx; height: 24rpx; background: var(--lm-line); }
