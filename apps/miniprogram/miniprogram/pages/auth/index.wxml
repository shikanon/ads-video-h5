<view class="theme-surface theme-{{theme}}">
  <view class="auth-screen">
    <view class="auth-content">
      <image class="auth-logo" src="/assets/lightmao-logo.png" mode="aspectFit" aria-hidden="true"/>
      <view class="ui-title auth-title">登录轻喵</view>
      <view class="ui-description auth-description">登录后保存你的素材、作品和积分。</view>
      <button size="mini" class="ui-primary wechat-login" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">{{busy ? '正在连接微信…' : '微信登录'}}</button>
      <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
      <button size="mini" class="auth-browse" bindtap="browse">暂不登录，先浏览</button>
      <view class="ui-description auth-rewards">首登送 <text class="auth-points">2,000</text> 积分 · 每日签到领 <text class="auth-points">1,000</text> 积分</view>
    </view>
    <view class="auth-footer">
      <view class="quiet">制作请求会发送到所配置的模型服务。</view>
      <view class="auth-legal">
        <button size="mini" class="auth-legal-link" bindtap="legal" data-type="terms">用户协议</button>
        <view class="auth-legal-divider" aria-hidden="true"/>
        <button size="mini" class="auth-legal-link" bindtap="legal" data-type="privacy">隐私说明</button>
      </view>
    </view>
  </view>
  <privacy-dialog id="privacy"/>
</view>
