.mr{min-height:100vh;background:#fff9ee;color:#69473c;padding:16px;font-size:14px;box-sizing:border-box}.mr-title{font-size:18px;font-weight:600;margin:10px 0}.mr-muted{font-size:12px;color:#947052;margin:10px 0;line-height:1.7}.mr-error{color:#a4452e;font-size:12px;margin:8px 0}.mr input,.mr textarea{box-sizing:border-box;width:100%;border:1px solid #e6d7bd;border-radius:10px;background:#fffdf8;padding:10px;font-size:13px;margin:12px 0}.mr input{height:44px;padding:0 10px}.mr textarea{height:190px;line-height:1.7}.mr textarea.mr-plan{height:280px}.mr button{font-size:12px;line-height:1.7;padding:8px 12px;background:#f4e3c6;color:#a74e2a;border:0;border-radius:8px;margin:0;box-sizing:border-box}.mr button::after{border:0}.mr .mr-primary{background:#c9612f;color:#fff}.mr-actions{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}.mr-card{border:1px solid #e6d7bd;background:#fffdf8;border-radius:12px;padding:12px;margin:12px 0}.mr .mr-project{display:block;width:100%;text-align:left;margin:8px 0}.mr-picker{position:fixed;inset:15vh 0 0;background:#fff9ee;border-radius:18px 18px 0 0;padding:16px;z-index:40;box-shadow:0 -5px 30px #0004}

.mr-shots{max-height:300px;border-top:1px solid #e6d7bd;margin:12px 0}.mr-shot{padding:12px 0;border-bottom:1px solid #e6d7bd;line-height:1.7}.mr-shot .mr-muted{margin:4px 0}
