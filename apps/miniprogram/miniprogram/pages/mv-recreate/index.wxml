<view class="mr theme-surface theme-{{theme}}"><view class="mr-title">原素材 MV 复刻</view><view class="mr-muted">选素材 → 分镜 → 样片 → 节点 → 整片</view><view class="mr-error" wx:if="{{error}}">{{error}}</view>
<view wx:if="{{!project}}" class="mr-card"><view class="mr-title">一句话做MV</view><button size="mini" bindtap="chooseFolder">▱ {{folderName||'选素材文件夹'}}</button><input placeholder="用画中归人文件夹做一支MV" value="{{folderPrompt}}" bindinput="folderPrompt" maxlength="12000"/><button size="mini" class="mr-primary" bindtap="makeFromFolder" disabled="{{busy}}">开始制作</button></view>
<view wx:if="{{choosingFolder}}" class="mr-picker"><scroll-view scroll-y style="max-height:55vh"><button size="mini" wx:for="{{folderChoices}}" wx:key="id" data-id="{{item.id}}" bindtap="selectFolder">▱ {{item.name}}</button></scroll-view><button size="mini" bindtap="closeFolders">取消</button></view>
<block wx:if="{{!project}}"><input placeholder="项目名称" value="{{name}}" data-field="name" bindinput="field" maxlength="80"/><textarea value="{{instructions}}" data-field="instructions" bindinput="field" maxlength="12000"/><view class="mr-actions"><button size="mini" data-role="reference" bindtap="pick">{{referenceId?'参考片已选':'① 选参考片'}}</button><button size="mini" data-role="audio" bindtap="pick">{{audioId?'配乐已选':'② 选配乐'}}</button><button size="mini" data-role="source" bindtap="pick">③ 原素材 {{sourceCount}}</button></view><button size="mini" class="mr-primary" bindtap="create" disabled="{{busy||!referenceId||!audioId||!sourceCount}}">创建复刻项目</button><view class="mr-muted">先在资源中上传素材；每个项目最多100项。参考片不能选作原素材。</view></block>
<view wx:else class="mr-card"><view class="mr-title">{{project.name}} <button size="mini" bindtap="rename" disabled="{{busy||job}}">改名</button></view><view class="mr-muted">{{project.duration}} 秒 · {{project.sourceIds.length}} 项原素材 · {{nodes.length}} 个成功节点</view><view wx:if="{{job}}">{{job.stage}}<button size="mini" bindtap="stop">停止</button></view><view class="mr-actions"><button size="mini" data-phase="plan" bindtap="action" wx:if="{{!project.plan.referenceEdit}}" disabled="{{busy||job}}">分析与分镜</button><button size="mini" bindtap="chat">查看任务</button><button size="mini" bindtap="retry" wx:if="{{retryable}}" disabled="{{busy||job}}">续做失败节点</button></view>
<block wx:if="{{project.plan}}"><view class="mr-actions"><button size="mini" data-phase="lyrics" bindtap="action" disabled="{{busy||job}}">识别歌词</button><button size="mini" bindtap="toggleLyrics" wx:if="{{project.lyricDraft}}">歌词校对</button><button size="mini" bindtap="useCinema" disabled="{{busy||job}}">{{project.plan.subtitleStyle==='cinematic'?'MV字幕 ✓':'MV字幕'}}</button></view><view wx:if="{{showLyrics}}" class="mr-card"><view class="mr-muted">识别草稿 · 试听校对</view><view class="mr-muted">改字后按整句显示；时间可调。</view><view wx:for="{{lyricRows}}" wx:key="index" class="mr-lyric"><input value="{{item.text}}" data-index="{{index}}" data-field="text" bindinput="editLyric" maxlength="36"/><view class="mr-actions"><input type="digit" value="{{item.start}}" data-index="{{index}}" data-field="start" bindinput="editLyric"/><text>—</text><input type="digit" value="{{item.end}}" data-index="{{index}}" data-field="end" bindinput="editLyric"/><text>秒</text><button size="mini" data-index="{{index}}" bindtap="removeLyric">删除</button></view></view><view class="mr-actions"><button size="mini" bindtap="openAudio">试听配乐</button><button size="mini" bindtap="useLyrics" disabled="{{busy||job}}">采用这些歌词</button></view></view><button size="mini" bindtap="toggleDetails">分镜与说明 {{shots.length}} {{showDetails?"−":"＋"}}</button><view wx:if="{{showDetails}}" class="mr-muted">{{project.plan.story}}</view><view class="mr-error" wx:if="{{showDetails}}" wx:for="{{project.plan.limitations}}" wx:key="*this">{{item}}</view><scroll-view wx:if="{{showDetails}}" scroll-y class="mr-shots"><view wx:for="{{shots}}" wx:key="index" class="mr-shot"><view>{{item.index}} / {{item.chapter}} / {{item.durationLabel}}s</view><view class="mr-muted">{{item.name}} / {{item.startLabel}}s</view><view>{{item.reason}}</view></view></scroll-view><button size="mini" bindtap="togglePlan">编辑分镜</button><button size="mini" wx:if="{{project.sourceFolderId}}" bindtap="rememberFolder" disabled="{{busy||job}}">存为文件夹原工程</button><block wx:if="{{editingPlan}}"><textarea class="mr-plan" value="{{planText}}" data-field="planText" bindinput="field" maxlength="150000"/><button size="mini" bindtap="savePlan" disabled="{{busy||job}}">保存分镜修改</button></block><view class="mr-actions"><button size="mini" data-phase="preview" bindtap="action" disabled="{{busy||job}}">确认分镜 · 20秒样片</button><button size="mini" data-id="{{project.previewArtifactId}}" bindtap="openArtifact" wx:if="{{project.previewArtifactId}}">查看样片</button><button size="mini" data-phase="render" bindtap="action" disabled="{{busy||job||!project.previewArtifactId}}">分节点制作整片</button></view><button size="mini" wx:if="{{nodes.length}}" bindtap="toggleNodes">节点 {{nodes.length}} {{showNodes?"−":"＋"}}</button><view wx:if="{{showNodes}}" class="mr-actions"><button size="mini" wx:for="{{nodes}}" wx:key="id" data-id="{{item.id}}" bindtap="openArtifact">节点 {{item.index}}</button></view><button size="mini" class="mr-primary" wx:if="{{project.artifactId}}" data-id="{{project.artifactId}}" bindtap="openArtifact">查看完整成片</button></block><view class="mr-actions"><button size="mini" bindtap="remove" disabled="{{job||busy}}">删除项目记录</button></view></view>
<view class="mr-title">我的复刻项目 <button size="mini" bindtap="newProject">＋ 新建</button></view><button size="mini" class="mr-project" wx:for="{{projects}}" wx:key="id" data-id="{{item.id}}" bindtap="openProject">{{item.name}}</button>
<view wx:if="{{picking}}" class="mr-picker"><input placeholder="搜索素材名称" value="{{query}}" bindinput="search"/><scroll-view scroll-y style="height:58vh"><button size="mini" class="mr-project" wx:for="{{media}}" wx:key="id" data-id="{{item.id}}" bindtap="select">{{item.selected?'✓ ':''}}{{item.name}}</button></scroll-view><button size="mini" bindtap="close">完成</button></view></view>
