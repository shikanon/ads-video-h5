.balance-card { padding: 40rpx; border: 1rpx solid #f2dfce; border-radius: 40rpx; background: linear-gradient(125deg,#fff6e8,#ffe9e1); margin-bottom: 30rpx; }.balance { font-size: 70rpx; font-weight: 750; color: #493a30; margin: 20rpx 0 12rpx; }.balance text { font-size: 24rpx; font-weight: 400; margin-left: 14rpx; color: #9c806a; }.balance-foot { border-top: 1rpx solid #e9cdbc; padding-top: 26rpx; margin-top: 32rpx; color: #9c806a; font-size: 21rpx; }.checkin-panel { padding: 38rpx; }.daily-value { text-align: center; padding: 40rpx 0; font-size: 56rpx; font-weight: 700; color: #bd924f; }.daily-value text { font-size: 23rpx; font-weight: 400; margin-left: 12rpx; }.checkin-hint { text-align: center; margin-top: 18rpx; }.welcome-gift { padding: 2rpx 6rpx 10rpx; }.welcome-gift .quiet { margin: 9rpx 0 0 28rpx; }.ledger { padding: 0 26rpx; }.entry { padding: 26rpx 0; border-bottom: 1rpx solid #f3eee6; font-size: 24rpx; }.entry:last-child { border: 0; }.entry-icon { background: #fff4e3; color: #c49c63; width: 60rpx; height: 60rpx; text-align: center; line-height: 60rpx; border-radius: 18rpx; flex-shrink: 0; }.entry-value { font-size: 25rpx; white-space: nowrap; }.entry .plus { color: #b18b50; }
.reward-mask { position: fixed; inset: 0; background: rgba(45,34,20,.48); z-index: 50; display: flex; align-items: center; justify-content: center; padding: 32rpx; }.reward-card { position: relative; width: 100%; max-width: 670rpx; max-height: 90vh; overflow-y: auto; background: radial-gradient(ellipse at 50% 36%,#fff0bd,transparent 60%),linear-gradient(#fff9ed,#fff1e1); border: 1rpx solid #efdabd; border-radius: 44rpx; padding: 55rpx 42rpx 36rpx; text-align: center; box-shadow: 0 24rpx 90rpx rgba(40,29,16,.2); animation: arrive .25s ease-out; }.reward-close { position: absolute; top: 16rpx; right: 20rpx; color: #ab977d; width: 50rpx; height: 50rpx; font-size: 40rpx; }.reward-ribbon { display: inline-block; font-size: 21rpx; border: 1rpx solid #e6cda6; border-radius: 30rpx; padding: 8rpx 18rpx; color: #b18b52; }.reward-date { margin-top: 24rpx; }.reward-art { position: relative; height: 290rpx; margin: 8rpx 0; display: flex; align-items: center; justify-content: center; }.halo { position: absolute; width: 270rpx; height: 270rpx; border: 1rpx solid #efd5a2; border-radius: 50%; box-shadow: 0 0 0 26rpx rgba(246,213,155,.12); }.coin-front,.coin-back { position: absolute; background: linear-gradient(140deg,#fff3b6,#efc170); border: 9rpx solid #ffecad; border-radius: 50%; color: #bb853a; box-shadow: inset 0 0 0 3rpx #d8b067,0 14rpx 0 #d5a957,0 25rpx 35rpx rgba(156,105,34,.15); display: flex; align-items: center; justify-content: center; }.coin-front { width: 176rpx; height: 176rpx; font-size: 76rpx; transform: rotate(-8deg); animation: float 3s ease-in-out infinite; }.coin-back { width: 112rpx; height: 112rpx; margin: 80rpx 0 0 196rpx; font-size: 48rpx; opacity: .65; }.spark-one,.spark-two { position: absolute; color: #caa44d; font-size: 44rpx; }.spark-one { top: 80rpx; left: 45rpx; }.spark-two { top: 56rpx; right: 70rpx; font-size: 32rpx; }.reward-title { color: #79552c; font-size: 30rpx; font-weight: 600; margin-top: 20rpx; }.reward-value { font-size: 70rpx; font-weight: 750; color: #b17b37; margin: 24rpx 0 20rpx; }.reward-value text { font-size: 23rpx; font-weight: 400; margin-left: 12rpx; }.reward-button { background: linear-gradient(90deg,#e7b364,#d5a052); margin-top: 36rpx; color: #624015; }.reward-foot { margin-top: 24rpx; }.claimed .coin-front { animation: pop .45s ease-out; }
@keyframes arrive { from { opacity: 0; transform: translateY(18rpx) scale(.96); } to { opacity: 1; transform: translateY(0) scale(1); } }@keyframes float { 0%,100% { transform: translateY(0) rotate(-8deg); } 50% { transform: translateY(-10rpx) rotate(-4deg); } }@keyframes pop { 0% { transform: scale(.8); } 60% { transform: scale(1.08); } 100% { transform: scale(1); } }
